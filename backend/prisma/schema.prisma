generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// level and proficiencyBonus are intentionally NOT columns here — they're
// always derived from experiencePoints at read time (see
// src/lib/leveling/experience.ts). Don't add them back as persisted fields.
//
// race/class/background are NOT columns here either — they're modeled as
// per-character selection rows (CharacterRace/CharacterClassEntry/
// CharacterBackground below) that each link to a baseline catalog entry via
// a nullable FK but carry their own display name. This lets a sheet's
// race/class/background name drift from (or fully replace) the catalog
// entry without breaking the link used for mechanical derivation, and lets
// class be one-to-many for future multiclass support.
//
// inventory follows the same pattern via InventoryItem below (and is NOT a
// Json column here) rather than the sparse-overlay shape race/class/
// background use: each row *snapshots* a catalog Item's stats at add-time
// instead of just a name, since equipment commonly needs every field edited
// (Club -> "Club +1" with bonus damage) and a snapshot needs no merge logic
// to read or write. itemId is kept only as a provenance pointer.
model Character {
  id        String @id @default(uuid())
  name      String
  alignment String

  // Uploaded-portrait blob key (#1615) — persisted content state, like
  // CampaignEntity.portraitKey, not derivable. The key itself NEVER goes on the
  // wire: serializeCharacter/serializeCharacterSummary derive the wire
  // `portraitUrl` (a relative /api/characters/:id/portrait path) from it at
  // read time, and it's mutated only by the portrait upload/delete endpoints.
  portraitKey String?

  // Owning user. Legitimately persisted (NOT derived) — ownership is identity
  // state, not a function of any other column, so it's exempt from the
  // derive-don't-persist rule that excludes level/proficiencyBonus/race/etc.
  // onDelete: Cascade — deleting a user removes their characters. "Only the
  // owner may read/write" is enforced (#101) via requireAuth (app.ts) +
  // assertCharacterAccess (lib/auth/access.ts), the single sharing seam (#116).
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Optional shared-campaign link (#246). SetNull so deleting a campaign leaves
  // the character intact (just unassigned).
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Authoritative rules edition for this sheet (#1281/#1285), read only through
  // editionOf. Persisted for the same reason as ownerId — it isn't a function of
  // any other column, so derive-don't-persist doesn't apply. It lives here and
  // not only on Campaign because a character may link to several campaigns and a
  // solo session (#1080) has none. Write-once (decided 2026-07-25): set by the
  // create transaction, absent from PATCH and every transaction op, which is what
  // lets each LEVEL_GATED_RECONCILERS entry treat edition as a constant.
  rulesEdition RulesEdition @default(EDITION_2024)

  experiencePoints Int @default(0)

  initiativeBonus Int
  speed           Int

  hitPoints     Json
  hitDice       Json
  abilityScores Json

  savingThrowProficiencies String[]
  skills                   Json
  // Array of { name, source } — tool proficiencies granted at character
  // creation by background / class / race. Never trimmed on level-down.
  // Level-gated choices (e.g. Student of War) live in resources Json instead.
  toolProficiencies        Json

  currency      Json
  spellcasting  Json?
  // Mutable resource state: { used: Record<key,count>, maneuversKnown: ManeuverEntry[] }.
  // Only `used` counts and known lists persist; totals/die-size/recharge are
  // derived at read time by deriveResources() in src/lib/srd.ts.
  resources     Json?
  // Mutable conditions state: { active: ConditionEntry[], exhaustion: number }.
  // `active` holds the standard 5e status conditions (prone, poisoned, etc.) by
  // boolean presence; `exhaustion` is a single 0–6 level (special case). The
  // canonical condition rules data lives in src/lib/srd.ts (CONDITIONS).
  conditions    Json?
  // Mutable active-effects state: { buffs: ActiveBuff[] }. Cast-granted stat
  // modifiers (e.g. a concentration buff spell), each tagged with the casting
  // entry id so they clear when that concentration ends. Normalized on read;
  // mutate via the cast path, never PATCH.
  activeEffects Json?

  raceSelection       CharacterRace?
  backgroundSelection CharacterBackground?
  classEntries        CharacterClassEntry[]
  inventoryItems      InventoryItem[]
  events              CharacterEvent[]
  sessionParticipants SessionParticipant[]
  journalEntries      JournalEntry[]
  // Back-relation to the PC CampaignEntity auto-created on attach (#248).
  campaignLink        CampaignCharacterLink?
  // Per-campaign play preferences (#537) — one row per campaign this character
  // has ever set prefs in; the current campaign's row is surfaced on read.
  campaignPreferences CampaignCharacterPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([campaignId])
}

// --- Identity & ownership ---------------------------------------------------
// Authentication user model. Wired to Character via ownerId so every sheet has
// an owner; per-owner read/write is enforced (#101) by requireAuth +
// assertCharacterAccess. Sign-in is OAuth/session via the AuthAccount /
// AuthSession tables (#100).

model User {
  id          String  @id @default(uuid())
  // Nullable + unique: an emailless bootstrap user can exist (single-player
  // today); OAuth/credential users added in #100 will carry an email.
  email       String? @unique
  name        String?
  imageUrl    String?
  // Account-synced player preferences (#1178: theme, dice-roll style,
  // auto-roll concentration) — typed JSON (see UserPreferences) so new keys
  // need no migration. NULL means "never stored" (distinct from a stored
  // object that happens to equal the defaults) — that marker is what lets
  // first-login migration push local values up without a later device's
  // untouched defaults clobbering real synced values.
  preferences Json?

  accounts   AuthAccount[]
  sessions   AuthSession[]
  characters Character[]

  // Shared campaigns (#246): ones this user owns + memberships in any campaign.
  ownedCampaigns      Campaign[]           @relation("CampaignOwner")
  campaignMemberships CampaignMembership[]

  // USER-scope catalog entries this user owns (#1796, epic #1795 1/6) —
  // homebrew content across every kind, not just Spell. Mirrors `characters`
  // — cascade-deleted with the user (CatalogEntry.ownerUser onDelete: Cascade).
  catalogEntries  CatalogEntry[]
  // Per-user dismissals of derived inbox flags (#1945).
  inboxDismissals InboxDismissal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Shared campaigns (#246) ------------------------------------------------
// A Campaign is a shared backbone several characters (and their owners) join.
// Plain-REST domain (NOT the transaction/audit pattern): membership is identity
// state, access is gated by CampaignMembership via assertCampaignMembership.

model Campaign {
  id           String       @id @default(uuid())
  name         String
  // The DM's default for characters created into this campaign (#1285). Never
  // authoritative for an existing sheet — Character.rulesEdition is, and joining
  // a campaign never converts it.
  rulesEdition RulesEdition @default(EDITION_2024)
  ownerId      String
  owner        User         @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Opaque random join code (same crypto as session tokens). Unique so /join
  // resolves a campaign by code.
  inviteCode   String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members              CampaignMembership[]
  characters           Character[]
  // Shared campaign wiki: NPCs/locations/factions/etc. tagged in notes (#248).
  entities             CampaignEntity[]
  // DM-authored campaign items, each auto-linked to an ITEM entity (#380).
  // CAMPAIGN-scoped Item rows (#1645/#1646) — the sole campaign-item relation
  // since the CampaignItem model was merged into Item and dropped.
  items                Item[]
  // Non-destructive "revealed to be" identity links between entities (#387).
  entityMerges         CampaignEntityMerge[]
  sessions             Session[]
  // Per-character play preferences scoped to this campaign (#537).
  characterPreferences CampaignCharacterPreference[]
  // Named parts/arcs the journal groups sessions under (#863). Campaign-level
  // (one shared story spine), DM-curated.
  arcs                 CampaignArc[]
  // CAMPAIGN-scope catalog entries this campaign owns (DM homebrew, #1796)
  // and GLOBAL/USER entries granted into this campaign for its players to see.
  catalogEntries       CatalogEntry[]
  catalogGrants        CatalogGrant[]
  // Per-user dismissals of this campaign's derived inbox flags (#1945).
  inboxDismissals      InboxDismissal[]
}

// A named part/arc of a campaign's story (#863): the journal page groups
// sessions ("chapters") under these so a long campaign stays navigable. Arcs
// are campaign-level (one shared spine for the whole party) and DM-only to
// curate — plain REST CRUD (like entities/journal), NOT the audit/transaction
// pattern, since they carry no character-sheet mechanical effect. `position`
// is an explicit ordering column the owner reorders; a session points at its
// arc via the nullable Session.arcId (SetNull on delete, so deleting an arc
// leaves its sessions intact and merely un-arced).
model CampaignArc {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  position   Int
  createdAt  DateTime @default(now())

  sessions Session[]

  @@index([campaignId, position])
}

// --- Inbox: derived DM housekeeping flags (#1945) --------------------------
// GET /api/inbox recomputes duplicate-entity-cluster and needs-chronicling
// flags at read time for every campaign the caller OWNS (derive-don't-
// persist) — nothing about a flag itself is stored, only that a user
// dismissed one. `signature` is the flag's stable identity (e.g. the sorted
// entity ids of a duplicate cluster); a cluster whose membership changes gets
// a new signature and resurfaces, which is intended.
enum InboxFlagKind {
  DUPLICATE_CLUSTER
  NEEDS_CHRONICLING
}

model InboxDismissal {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind       InboxFlagKind
  signature  String
  createdAt  DateTime      @default(now())

  // campaignId is part of the identity (not just an FK) so the stored column
  // actually governs suppression, matching filterDismissed's match key — a
  // dismissal never silently applies across campaigns. Covers the old
  // [userId, campaignId] index as a prefix, so that index is gone.
  @@unique([userId, campaignId, kind, signature])
}

enum CampaignRole {
  OWNER
  PLAYER
}

// 2014 = SRD 5.1, 2024 = SRD 5.2 (#1281). Both are supported editions; neither
// is legacy.
enum RulesEdition {
  EDITION_2014
  EDITION_2024
}

// Domain for Subclass.casterFraction (#1531) — see that column's own comment
// for why this is an enum rather than a plain string. Single member today:
// only a third-caster subclass (Eldritch Knight / Arcane Trickster) grants
// spellcasting of its own in 5e.
enum SubclassCasterFraction {
  third
}

model CampaignMembership {
  id         String       @id @default(uuid())
  campaignId String
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       CampaignRole @default(PLAYER)
  joinedAt   DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([campaignId, userId])
}

// --- Campaign entity registry & @-tagging (#248) ----------------------------
// A shared campaign wiki: a polymorphic registry of the people/places/things a
// table references. Fully polymorphic (one `type` discriminator, NO per-type FK
// columns) so a new entity kind is an enum value, not a table. Notes @-tag an
// entity via an @[<uuid>] token in the body; JournalEntryRef materializes each
// tag as a backlink. A PC entity is auto-created + linked when a character
// attaches to the campaign (CampaignCharacterLink).

enum EntityType {
  NPC
  LOCATION
  FACTION
  ITEM
  PC
  OTHER
}

// DM-controlled reveal state (#379): HIDDEN entities are invisible to non-owner
// members (list/detail/backlinks/mentions); the owner always sees all. New rows
// default REVEALED so auto-created PC entities and the pre-#379 backfill are open.
enum EntityVisibility {
  HIDDEN
  REVEALED
}

model CampaignEntity {
  id          String           @id @default(uuid())
  campaignId  String
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type        EntityType
  name        String
  aliases     String[]         @default([])
  notes       String?
  // Uploaded-portrait blob key (#1617), like Character.portraitKey: the key
  // itself NEVER goes on the wire — toWireEntity derives the wire portraitUrl
  // (a relative /api/campaigns/:id/entities/:entityId/portrait path) at read
  // time, and it's mutated only by the entity portrait upload/delete endpoints.
  portraitKey String?
  visibility  EntityVisibility @default(REVEALED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  refs          JournalEntryRef[]
  characterLink CampaignCharacterLink?
  // Back-relation to the DM-authored item this entity fronts (#380).
  itemLink      CampaignItemLink?
  // Identity-merge back-relations (#387): the (single) merge where this entity
  // is the old identity, and the merges where it is the surviving true identity.
  mergedInto    CampaignEntityMerge?   @relation("MergedIdentity")
  survivorOf    CampaignEntityMerge[]  @relation("SurvivorIdentity")

  @@index([campaignId, type])
}

// Materialized backlink: one row per (entry, entity) tag. Derived from the
// @[<uuid>] tokens in the entry body on journal write; cascades from both sides.
model JournalEntryRef {
  id       String         @id @default(uuid())
  entryId  String
  entry    JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entityId String
  entity   CampaignEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entryId, entityId])
  @@index([entityId])
}

// Links a character to its auto-created PC entity (1:1 both ways).
model CampaignCharacterLink {
  id               String         @id @default(uuid())
  campaignEntityId String         @unique
  campaignEntity   CampaignEntity @relation(fields: [campaignEntityId], references: [id], onDelete: Cascade)
  characterId      String         @unique
  character        Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// --- Entity identity merges (#387) ------------------------------------------
// A non-destructive "revealed to be" link: `mergedEntity` (the old identity,
// e.g. Jenkins) is the same being as `survivorEntity` (the true identity, e.g.
// Vecna). Neither row is destroyed and no journal ref is rewritten — a chip that
// tagged the old id keeps resolving to the old id. PREPARED is the DM's secret
// prep (scrubbed from every non-owner payload, like a HIDDEN entity #379);
// EXECUTED is the public reveal. Chains resolve transitively (Jenkins→Vecna→
// Whispered One). Cascades from either entity so the record dies with either side.
enum MergeStatus {
  PREPARED
  EXECUTED
}

model CampaignEntityMerge {
  id               String         @id @default(uuid())
  campaignId       String
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // The old identity; at most one merge per merged entity.
  mergedEntityId   String         @unique
  mergedEntity     CampaignEntity @relation("MergedIdentity", fields: [mergedEntityId], references: [id], onDelete: Cascade)
  // The surviving true identity (may itself be merged further up the chain).
  survivorEntityId String
  survivorEntity   CampaignEntity @relation("SurvivorIdentity", fields: [survivorEntityId], references: [id], onDelete: Cascade)
  status           MergeStatus    @default(PREPARED)
  note             String?
  preparedAt       DateTime       @default(now())
  executedAt       DateTime?

  @@index([campaignId])
  @@index([survivorEntityId])
}

// Links a CAMPAIGN-scoped Item to its auto-created ITEM entity (1:1 both ways), same
// pattern as CampaignCharacterLink. DELETE cleanup rule (routes/items.ts):
// deleting the item deletes BOTH this link (cascade) AND the fronting entity
// (explicit, in the same transaction) — the entity has no life without its item.
model CampaignItemLink {
  id               String         @id @default(uuid())
  campaignEntityId String         @unique
  campaignEntity   CampaignEntity @relation(fields: [campaignEntityId], references: [id], onDelete: Cascade)
  // Points at a CAMPAIGN-scoped Item since #1646 merged the two definition
  // tables; the name still describes what it links, so the model keeps it.
  itemId           String         @unique
  item             Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// --- Campaign-scoped character preferences (#537) ---------------------------
// A player's per-campaign play settings for one of their characters (e.g. share
// sheet with the DM, auto-roll friendly healing). Scoped to (campaign,
// character) so the same character can carry different settings across
// campaigns. Owner-only writes via assertCharacterAccess; both FKs cascade so a
// deleted campaign or character removes its preference rows.
model CampaignCharacterPreference {
  id          String    @id @default(uuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // Let the DM read this character's sheet (lands with #116 sharing).
  shareWithDm         Boolean @default(false)
  // Auto-roll healing when this character targets a friendly (lands with #462).
  autoFriendlyHealing Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, characterId])
  @@index([characterId])
}

// One row per linked sign-in method (OAuth provider account or, later, a
// local-credentials record). Tokens live HERE, never on User, so a user can
// hold several providers and rotating tokens never touches the identity row.
// passwordHash is future-credentials-only and stays null for OAuth accounts.
model AuthAccount {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  // Null for OAuth; set only when local username/password credentials are
  // added in a future iteration.
  passwordHash      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

// Server-side session. `id` is the opaque cookie token itself (NO default) —
// it's generated by the auth layer and stored verbatim, so a leaked token
// can't be guessed from a sequential/uuid pattern we control here.
model AuthSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// --- Reference catalog -----------------------------------------------------
// Baseline lists offered in the character-creation form. These are seeded
// from a small SRD subset (see prisma/seed.ts) and are NOT referenced
// directly by Character — only through the nullable FKs on the selection
// models below, so deleting/renaming a catalog row never breaks an existing
// character sheet.

// --- Species catalog (#1679, epic #1518) ------------------------------------
// Parent+variant catalog for the two-step species→variant creation choice
// (2014 race→subrace, 2024 species→lineage/legacy/ancestry) — the SOLE
// mechanical anchor since #1684 pruned the flat `Race` model and
// `CharacterRace.raceId` (which served the legacy creation path through
// #1679-#1683). `edition` is NOT NULL, unlike Subclass/Feat/Background's nullable `edition`:
// no species is edition-neutral — rosters, ability increases, and trait text
// all fork per edition (the ACTIONS/#1430 transcription rule), so a 2014 and
// a 2024 Dwarf are two rows sharing a name, never one shared row. Children
// (SpeciesVariant/SpeciesTrait/SpeciesGrantedSpell) carry NO edition column of
// their own — they inherit it through speciesId, so a cross-edition check is
// always a parent-edition comparison (see character-create.ts's
// resolveSpeciesSelection).
model Species {
  id               String       @id @default(uuid())
  name             String
  slug             String
  speed            Int
  edition          RulesEdition
  // AbilityIncreaseSpec[] — fixed | choose | floating (abilityIncreasesSchema,
  // lib/srd/species-ability-increases.ts). [] for every EDITION_2024 row: 2024
  // ability increases come from backgrounds only (#1572), never species (epic
  // body, pinned by a negative test both directions). Read and baked into
  // effective scores at creation by resolveSpeciesGrants (character-create.ts,
  // #1681); the applied result is snapshotted onto CharacterRace.abilityBonuses.
  abilityIncreases Json         @default("[]")

  variants      SpeciesVariant[]
  traits        SpeciesTrait[]
  grantedSpells SpeciesGrantedSpell[]
  selections    CharacterRace[]

  @@unique([name, edition])
  @@unique([slug, edition])
}

// A species' second creation step: 2014 subrace, 2024 lineage/legacy/ancestry,
// or — in BOTH editions — Dragonborn's Draconic Ancestry (epic review decision
// 7: PHB'14 calls it a trait rather than a subrace, but the schema has exactly
// one place for a species-level creation choice, and this is it). No `edition`
// column — inherits the parent Species row's edition.
model SpeciesVariant {
  id                      String  @id @default(uuid())
  speciesId               String
  species                 Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  name                    String
  slug                    String
  // NULL = use the parent Species.speed (the common case). Set only when the
  // book states a different value for this variant (PHB'14 Wood Elf 35 ft;
  // no 2024 variant seeded this slice overrides speed).
  speedOverride           Int?
  // Same AbilityIncreaseSpec[] shape as Species.abilityIncreases, additive to
  // the parent's at creation (PHB'14 Hill Dwarf +1 WIS on top of Dwarf's own
  // +2 CON — the create phase merges both levels, #1681). [] for every 2024
  // row and for every Dragonborn ancestry variant in either edition (draconic
  // ancestry grants a damage type + resistance, never an ability increase).
  abilityIncreases        Json    @default("[]")
  // When true, `abilityIncreases` REPLACES the parent Species' increases at
  // creation instead of adding to them (fetchMergedAbilityIncreases). Only the
  // Astral Elf sets this (#1751): a Spelljammer standalone race modelled as an
  // Elf variant, it carries a Tasha's-era floating spread and must NOT inherit
  // the base Elf's +2 DEX the way real subraces (High/Wood/Drow) do. Default
  // false keeps every existing subrace additive.
  abilityIncreasesReplace Boolean @default(false)

  traits        SpeciesTrait[]
  grantedSpells SpeciesGrantedSpell[]
  selections    CharacterRace[]

  @@unique([speciesId, name])
  @@unique([speciesId, slug])
}

// Species trait content — table only in this slice; every row's actual prose
// and mechanics are authored in #1682 (slice 4), including the Dragonborn
// ancestry variants' breath weapon + resistance. speciesId is required (every
// trait belongs to a species); variantId is NULL for a species-level trait
// (the majority — Dwarven Resilience) and set for a variant-only one (Hill
// Dwarf's Dwarven Toughness) — same base-required/child-optional shape as
// ClassFeature's classId/subclassId.
model SpeciesTrait {
  id           String          @id @default(uuid())
  speciesId    String
  species      Species         @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      SpeciesVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name         String
  description  String
  // FeatImprovement[] vocabulary (Feat.improvements, srd/feats.ts) reused
  // verbatim so #1682's derivation layer needs no new shape, only a new source.
  improvements Json            @default("[]")
  // #1689: the player-CHOICE vocabulary a fixed FeatImprovement can't express
  // ("choose two skills", "choose a cantrip") — speciesTraitChoiceSchema
  // (lib/srd/species-trait-choices.ts). NULL for every announce-only or
  // fixed-only trait (the vast majority); set on exactly the ONE trait row
  // that carries the choice (Half-Elf's own Skill Versatility row, High Elf's
  // own Cantrip row) so the choice stays tied to its citation + description —
  // the same "identity lives on the trait row" shape #1682 established,
  // rather than a second spec column on Species/SpeciesVariant. A single
  // object, not an array like `improvements`: one trait row is always exactly
  // one mechanic, never a bundle of choices.
  choice       Json?

  // Postgres does not auto-index FK columns; #1682 resolves traits by species
  // (include: { traits: true }) and by variant, and a species prune cascades on
  // speciesId — index both so neither becomes a full table scan (#1679 review).
  @@index([speciesId])
  @@index([variantId])
}

// A spell a species/variant grants for free — sibling of SubclassGrantedSpell
// (2024 lineage spell tracks land in #1683/slice 6), deliberately NOT the same
// table: a species grant's source is the species/variant, never a subclass.
// Unlike SubclassGrantedSpell's nullable `edition` (a genuine shared-vs-forked
// axis), this has no edition column at all — it inherits edition through
// speciesId, the same as every other Species child. No rows seeded this slice.
model SpeciesGrantedSpell {
  id        String          @id @default(uuid())
  speciesId String
  species   Species         @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  variantId String?
  variant   SpeciesVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  spellId   String
  spell     Spell           @relation(fields: [spellId], references: [id], onDelete: Cascade)
  gateLevel Int

  @@index([speciesId])
}

model CharacterClass {
  id                String   @id @default(uuid())
  name              String   @unique
  hitDie            String // e.g. "d8"
  savingThrows      String[] // ability names, e.g. ["strength", "constitution"]
  skillChoiceCount  Int
  skillChoices      String[] // eligible skill names to choose from
  isSpellcaster     Boolean  @default(false)
  // The 2014 (PHB'14) level at which this class first grants a subclass choice
  // — Cleric/Sorcerer/Warlock = 1, Wizard/Druid = 2, most others = 3. SRD 5.2
  // (2024) ignores this column outright: subclassGateLevel hardcodes 3 for
  // every class under EDITION_2024, so one row serves both editions (#1308).
  subclassLevel     Int      @default(3)
  // Tool proficiency grants — fixed tools the class always grants.
  toolProficiencies String[] @default([])
  // Tool proficiency choices — player picks toolChoiceCount from this list.
  toolChoices       String[] @default([])
  toolChoiceCount   Int      @default(0)

  // ---- #1529: the last class-table content still keyed by class NAME in
  // ---- lib/srd/ Record<string,...> literals, moved onto this row so
  // ---- resolution is by FK (fixes #1388's class half — a lowercase/display-
  // ---- name entry with the same classId now resolves identically).

  // Fixed armor/weapon proficiency grants (PHB). SEEDED WITH SRD 5.1/PHB'14
  // VALUES ONLY — at least Bard/Druid/Monk/Rogue/Sorcerer/Wizard genuinely
  // differ in SRD 5.2/PHB'24 (broader "Simple weapons" grants, a property-
  // scoped Martial subset, Druid's shields going nonmetal). This column has
  // no `edition` split (CharacterClass has none), so when the 2024 lists are
  // authored (their own follow-up issue — never guessed here) the fork takes
  // the `subclassLevel`/`subclassGateLevel` shape: one rule function reading
  // this column with `edition` as its last parameter, never a second column
  // and never `=== "EDITION_…"`.
  armorProficiencies      String[] @default([])
  weaponProficiencies     String[] @default([])
  // ASI/feat slot levels BEYOND the edition-invariant base schedule
  // (4/8/12/16/19, BASE_ASI_LEVELS) — Fighter [6,14], Rogue [10], [] for
  // every other class. CLAUDE.md lists ASI levels among the rules where
  // 2014 and 2024 agree, so this is one column, no edition fork.
  extraAsiLevels          Int[]    @default([])
  // The character level at which this class grants a Fighting Style feat pick
  // (Fighter 1, Paladin/Ranger 2 — agrees in both editions); NULL = this class
  // never grants one. What differs by edition is feat-vs-menu (SRD 5.2 p. 47,
  // #1137's concern), not this level, so no edition fork here either.
  fightingStyleFeatLevel  Int?
  // 5e multiclass ability-score prerequisite (PHB'14 p. 163): an array of AND-
  // option-groups, OR'd together — e.g. Fighter's `[{strength:13},
  // {dexterity:13}]` (the only OR class), Paladin's `[{strength:13,
  // charisma:13}]` (a single AND group). Json (not String[]) because only it
  // can express the OR-of-AND shape; edition-invariant per CLAUDE.md.
  multiclassPrerequisites Json     @default("[]")
  // PHB'24 class-table "Primary Ability" column — the ability(ies) the
  // creation ability panel recommends (#1161). NOT a 2014/2024 agreement:
  // PHB'14 has no such table column (Quick Build suggestions instead), so
  // this is 2024-sourced with no 2014 counterpart, not edition-invariant
  // content pretending to be shared.
  primaryAbilities        String[] @default([])

  entries                   CharacterClassEntry[]
  subclasses                Subclass[]
  // Back-relation only — not a column, appears on no payload unless included
  // (#1522/#1523's ClassFeature foundation).
  features                  ClassFeature[]
  // Back-relation only — not a column, appears on no payload unless included
  // (#1519/#1533's StartingEquipmentPackage foundation).
  startingEquipmentPackages StartingEquipmentPackage[]
}

// Subclass catalog — Pattern A (like Species/CharacterClass). Each row is a
// named subclass belonging to one CharacterClass. The nullable FK on
// CharacterClassEntry.subclassId points here; `onDelete: SetNull` keeps
// existing entries intact if a catalog subclass is ever removed. Homebrew
// subclasses are represented by a null subclassId with a drifting name string,
// same as homebrew races/classes/backgrounds.
model Subclass {
  id                  String                  @id @default(uuid())
  classId             String
  class               CharacterClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  name                String
  description         String
  // Stable mechanics identity: the join key between this catalog row and the
  // lib/classes/*.ts definition that implements it (#1277). Immutable — a
  // display-name rename must NOT change it, which is the whole point: a player
  // can edit `name`, and one lineage's 2014/2024 names differ, which is how the
  // substring join let a "Way of Shadow" monk inherit Warrior of Shadow (#1339).
  // Vocabulary is SUBCLASS_SLUGS; resolveSubclassSlug is the ONE place a
  // character resolves onto it. Generated once from (class, name) by this
  // column's migration as an authoring CONVENTION for new rows, never at read time.
  slug                String
  // NULL = valid in both editions; a diverging subclass (gate level, grants)
  // forks into one row per edition sharing this name (#1306). Kept named
  // "classId_name" (not classId_name_edition) so the compound-key literal at
  // every existing call site only grows an `edition` field, not a rename.
  // NULLS NOT DISTINCT on the migration's unique index — see resolveEditionRow,
  // the single place the exact/NULL fallback ordering is expressed.
  edition             RulesEdition?
  // Third-caster identity (#1531): NULL for every subclass that grants no
  // spellcasting of its own (the vast majority — Champion, Battle Master, …).
  // "third" for Eldritch Knight / Arcane Trickster today. A Prisma enum
  // (review finding 1), not a plain string like SubclassGrantedSpell.
  // castingAbility below: THIS column feeds thirdCasterAbilityOf's
  // `!== "third"` gate directly, so an unrecognized value must be a compile
  // error at every call site, not a silently-false runtime comparison — the
  // same failure shape #1339 already taught this codebase to close at
  // compile time, just for a value instead of a name. Extend the enum (never
  // add a second column) if a half/full-caster subclass ever needs one.
  // Replaces the retired THIRD_CASTER_SUBCLASSES name-keyed lookup
  // (spellcasting-tables.ts) — a renamed or homebrew subclass now carries its
  // own mechanics on this row instead of matching a display name.
  casterFraction      SubclassCasterFraction?
  // Governing ability for this subclass's granted spellcasting ("intelligence"
  // for EK/AT) — NULL alongside casterFraction for a non-caster subclass.
  // Plain string (unlike casterFraction): the value space is 5e's six ability
  // names, already used loosely as strings everywhere in this codebase
  // (SPELLCASTING_ABILITY, SubclassGrantedSpell.castingAbility above) — no
  // single call site branches on it the way thirdCasterAbilityOf branches on
  // casterFraction, so there's no compile-time gate to buy with an enum here.
  spellcastingAbility String?

  selections          CharacterClassEntry[]
  grantedSpells       SubclassGrantedSpell[]
  // Back-relation only — not a column, appears on no payload unless included
  // (#1522/#1523's ClassFeature foundation).
  features            ClassFeature[]
  // Back-relation only, same role as grantedSpells (#1631) — the choosable-pool
  // widening a picker resolves, not a sheet-facing payload field.
  spellListExpansions SubclassSpellListExpansion[]

  @@unique([classId, name, edition], name: "classId_name")
  // The slug-form twin of classId_name: a lineage that forks across editions
  // keeps ONE slug and two rows (#1306), so edition is part of the key. NULLS
  // NOT DISTINCT lives in the migration (Prisma's DSL can't express it), same
  // as 20260726111922_catalog_edition_tagging's three indexes.
  @@unique([slug, edition], name: "slug_edition")
}

// A spell a subclass grants for free (always-prepared), keyed to the shared Spell
// catalog by FK — the subclass's spell content lives once, in the catalog, and is
// referenced here rather than snapshotted (#898). Resolved live at read time in
// deriveGrantedSpells; never persisted onto the character. Homebrew subclasses
// (once they own Subclass rows, #911) grant spells by adding rows here — no code.
model SubclassGrantedSpell {
  id             String        @id @default(uuid())
  subclassId     String
  subclass       Subclass      @relation(fields: [subclassId], references: [id], onDelete: Cascade)
  spellId        String
  spell          Spell         @relation(fields: [spellId], references: [id], onDelete: Cascade)
  // Character level at which the grant becomes active (the subclass grant level).
  // No default: real grants span levels 1–17 (Cleric 1/3/5/7/9, Paladin
  // 3/5/9/13/17), so every seed/write sets it explicitly (#913).
  gateLevel      Int
  // Ability the granted spells use for save DC / attack bonus (lowercase, e.g.
  // "wisdom" | "charisma"). Uniform per subclass in 5e; stored per-row for simplicity.
  castingAbility String
  // NULL = granted in both editions (#1625); a list that diverges forks into
  // one row per edition (same NULL-as-shared convention as Subclass above).
  // A granted-spell list is a SET, so the read path is a set filter in
  // deriveGrantedSpells (edition-or-NULL admission), NOT resolveEditionRow's
  // pick-one fallback. The widened unique below still ADMITS a (subclass,
  // spell, NULL) row alongside a tagged twin — that mix is forbidden at
  // authoring time by seed-data.test.ts's shared-XOR-forked guard, since the
  // set filter would serve both rows to one character. NULLS NOT DISTINCT
  // lives in the migration (Prisma's DSL can't express it), same as
  // 20260726111922_catalog_edition_tagging's indexes.
  edition        RulesEdition?

  @@unique([subclassId, spellId, edition])
  @@index([subclassId])
}

// A spell a subclass adds to the CHOOSABLE class spell list (#1631) — sibling
// of SubclassGrantedSpell but categorically distinct: this is not a free
// grant, it widens what a known caster may PICK, still spending an ordinary
// spells-known slot. PHB'14's Warlock patrons ("Add fiend spells to your
// warlock list") are the shape: The Fiend/The Archfey/The Great Old One's
// Expanded Spell List. Carries no gateLevel (the known-caster picker already
// gates a choice by spell level vs. available slots) and no castingAbility
// (the warlock learns the spell with its own casting ability, not a per-grant
// one) — both deliberate omissions vs. SubclassGrantedSpell, owner decision
// on #1631. Resolved live by the creation/level-up spell pickers, unioned
// into the choosable pool; never persisted onto the character.
model SubclassSpellListExpansion {
  id         String        @id @default(uuid())
  subclassId String
  subclass   Subclass      @relation(fields: [subclassId], references: [id], onDelete: Cascade)
  spellId    String
  spell      Spell         @relation(fields: [spellId], references: [id], onDelete: Cascade)
  // NULL = valid in both editions; a list that diverges forks into one row per
  // edition — same NULL-as-shared convention as SubclassGrantedSpell.edition.
  // An expansion list is a SET, so the read path is a set filter (edition-or-
  // NULL admission), not resolveEditionRow's pick-one fallback. NULLS NOT
  // DISTINCT lives in the migration (Prisma's DSL can't express it), same as
  // SubclassGrantedSpell's own edition unique.
  edition    RulesEdition?

  @@unique([subclassId, spellId, edition])
  @@index([subclassId])
}

// Seeded home for the per-class feature text that lived in twelve lib/classes/
// *.ts modules as DerivedFeature[] (#1522/#1523). Real relations (not bare
// scalar FKs) to CharacterClass/Subclass, both onDelete: Cascade — #1524's
// read path is "arrives through the include that already loads class/
// subclass", which needs a `features` field on both parents to include, and
// #1522 forbids making the derivation path async (the only alternative to a
// relation here). classId is required (every feature belongs to a class);
// subclassId is NULL for a base-class feature (the majority of rows).
model ClassFeature {
  id          String         @id @default(uuid())
  classId     String
  class       CharacterClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subclassId  String?
  subclass    Subclass?      @relation(fields: [subclassId], references: [id], onDelete: Cascade)
  name        String
  level       Int // absolute character level (#1522's settled Q1 — copy 2014 subclass-grant levels verbatim)
  description String

  // Non-nullable, unlike Subclass/Feat/GrantedAbility/Background/Action's
  // `edition RulesEdition?` (NULL there means "shared"). Here every row
  // forks: this is the enforcement mechanism for "every class-authoring unit
  // is a row per edition" (#1522 decision), which makes resolveEditionRow's
  // shared-row (edition: null) fallback unreachable BY TYPE for this family —
  // the #1430/#1519 "silently ambiguous which document a row cites" failure
  // class cannot be expressed here at all.
  edition RulesEdition

  // ---- Descriptor columns (#1522 decision 3). Every one is NULL/default
  // ---- after this migration — #1528 populates Fighter's, then each wave-2
  // ---- per-class retab its own. Authored once here (one migration) rather
  // ---- than re-migrating all 522 text rows a second time when #1528 lands.

  // Resource block — replaces the pool this feature declares in resourceFn.
  // `resourceRecharge` is a flat scalar; `resourceRechargeTiers` below covers
  // a recharge cadence that changes mid-progression instead (e.g. Bardic
  // Inspiration's longRest-then-short-or-long shift at level 5). Bardic
  // Inspiration itself still stays resourceFn-derived (#1224, bard.ts) — not
  // for its recharge or its Cha-mod total, both now expressible on a row, but
  // for its level-conditional description text (die size and rest type
  // interpolated inline, #1528's no-second-string rule).
  resourceKey           String?
  resourceLabel         String?
  resourceRecharge      String? // RechargeOn
  resourceTotals        Json? // [{ minLevel, total }] — total: number | "proficiencyBonus" | { abilityMod, min? } | { levelTimes } (#1685) — ASCENDING by minLevel, last-match-wins
  resourceDieTiers      Json? // [{ minLevel, die }]   — ASCENDING by minLevel, last-match-wins
  resourceRechargeTiers Json? // [{ minLevel, recharge }] — recharge: RechargeOn — ASCENDING by minLevel, last-match-wins
  resourceDetailTiers   Json? // [{ minLevel, label, value }] — labeled display parts (#1685's DerivedResource.details) — ASCENDING by minLevel PER LABEL, last-match-wins per label; different labels interleave freely

  // Activation block — replaces this feature's DERIVED_ACTIONS row. No gate
  // columns: grantClass IS classId, grantSubclassSlugs IS subclassId,
  // grantLevel IS level — one row, one gate.
  activationCost     String? // ActionCost: action | bonusAction | reaction | free | special
  resolverKind       String? // ResolutionKind — served on the wire, retiring the frontend mirror
  requiresUnarmored  Boolean  @default(false)
  regrants           String[] @default([])
  // Declarative activation-time gates (#1688): a closed vocabulary — armor/
  // shield literals ("noMediumArmor" | "noHeavyArmor" | "noShield" |
  // "noBodyArmor") plus `{ requiresActiveBuff: <buffKey> }`, evaluated by
  // unmetActivationRequirements at activation, server-side, inside
  // applyRowDrivenActionInTx — never
  // re-derived client-side. Bladesong (#1676) is the first `noMediumArmor`/
  // `noHeavyArmor`/`noShield` consumer; Song of Defense's `requiresActiveBuff`
  // and Elemental Attunement's burst/strike ops are the follow-ons. Validated
  // seed-time (classFeatureSeedSchema).
  activationRequires Json?
  // Static in-play announce text (#1909) — distinct from `description` (the
  // feature prose): this is what a player reads when they actually USE the
  // action, e.g. Lay on Hands' "touch a creature to restore HP" line.
  // `buildRowAction` (lib/classes/actions.ts) serves it only when
  // `describeRowReminder`'s derived heal text yields nothing, so a row with
  // an effectKind (Second Wind) keeps its computed "Regain NdM HP" subtitle
  // over this column. Validated seed-time (classFeatureSeedSchema).
  reminder           String?
  // A resolved numeric fact about this action the client renders verbatim
  // (#1912) — the row-authored counterpart to DERIVED_ACTIONS' retired
  // `count` field (actions.ts), e.g. Flurry of Blows' strike count (2
  // normally, 3 at Heightened Focus, monk L10). `buildRowAction` serves it
  // verbatim; a level-gated bump is an announce-augmentor payload (#1910),
  // never a second row.
  count              Int?
  // Marks a row that exists ONLY to carry one action VARIANT of a feature
  // that grants several (Patient Defense free vs. 1-Focus, Step of the
  // Wind's pair, Empty Body's two ki options, the Deflect riders, Hand of
  // Healing's Flurry variant, #1912/epic #1903 decision 4) — or, more
  // generally, any action identity with no feature-card text of its own.
  // `featuresFromRows` (lib/classes/class-feature-rows.ts) filters an
  // `actionOnly` row out, so it never surfaces as a feature card, in the
  // level-up ceremony's feature list, or anywhere else `DerivedFeature` is
  // projected — ONLY in `availableActions[]`. Requires `activationCost` +
  // `resourceKey` (enforced at seed time, classFeatureSeedSchema): a row
  // with neither is dead data, invisible everywhere.
  actionOnly         Boolean  @default(false)

  // Cost block — GrantedAbility's columns verbatim (AbilityCostColumns is
  // exactly these four, all optional) so readAbilityCost reads them unchanged.
  costKind    String?
  costPoolKey String?
  costBase    Int?
  costPerStep Int?

  // Effect block — GrantedAbility's columns MINUS upcastDicePerLevel,
  // cantripScaling and concentration. Those three are deliberately NOT
  // copied: EffectRow is `EffectColumns & { level: number }` and
  // resolveEffectScaling reads `row.level` as the SPELL level, while this
  // model's `level` is the CHARACTER level the feature is gained at. A
  // ClassFeature row handed straight to readEffectSpec would typecheck and
  // silently reinterpret the grant level — turning Second Wind (grant level
  // 1) into an upcastable spell. Inert only because these three columns are
  // absent; #1528 must adapt the row (e.g. `{ ...row, level: 0 }`) or use a
  // dedicated reader, never add these three columns back to "complete" the copy.
  effectKind           String?
  effectDiceCount      Int?
  effectDiceFaces      Int?
  effectDieSource      String?
  effectModifier       Int?
  // "classLevel" | "abilityMod:<ability>" — the ONE column decision 3 adds
  // beyond GrantedAbility's shipped vocabulary (#1528 earns it with content).
  // NOT in EffectColumns, so readEffectSpec ignores it until #1528 wires it.
  effectModifierSource String?
  damageType           String?
  attackType           String?
  saveAbility          String?
  saveEffect           String?
  buffTarget           String?
  buffModifier         Int?

  // A passive derived-stat modifier is NOT a #900 C2b buff (duration-bound:
  // while-active/until-rest) — Extra Attack (#1530), crit range (#1120) and
  // half-proficiency (#1124) are permanent and level-gated, read synchronously
  // in serializeCharacter off these two columns. Populated by nobody yet; the
  // VALUE vocabulary is defined by whichever of #1530/#1120 populates it
  // first — this issue invents none. Recorded as a comment on #900.
  derivedStat      String?
  derivedStatTiers Json? // [{ minLevel, value }] — ASCENDING by minLevel, last-match-wins

  // A closed-form save DC a class/subclass row announces from the abilities
  // named here (#1546): 8 + proficiency bonus + the higher of these
  // abilities' modifiers (Battle Master maneuvers, PHB'14 p.73 / PHB'24
  // p.83). Genuinely generic in FORMULA — Monk's focus DC, Cleric's turn DC,
  // Barbarian's frighten DC and Rogue's assassin DC are the same closed form
  // hardcoded into class TS strings today — not a Fighter special case, and
  // (#1589) now a genuinely live path for a BASE-CLASS row too: registry.ts's
  // deriveRowExtras runs over both classRows (unconditional) and an active
  // subclass's subclassRows, feeding ClassExtras.announcedSaveDC (renamed
  // from the Fighter-specific `maneuverSaveDC`). Still only Combat Superiority
  // (a SUBCLASS row) actually sets this column in production — Cleric's Turn
  // Undead/Channel Divinity deliberately still don't (cleric-features.ts's own
  // header): `announcedSaveDC` stays a SINGLE scalar overlaid across every
  // class entry (deriveEntryScopedResources), so two entries each declaring
  // one is a real collision — registry.ts's overlay throws on it rather than
  // silently letting one clobber the other, and Cleric already serves its own
  // DC through a fully independent, already-correct path
  // (channelDivinitySaveDC, lib/classes/channel-divinity.ts) with no need to
  // risk that collision for zero consumer benefit. Deliberately NOT layered
  // onto derivedStat/derivedStatTiers: the DC is per-character ability math,
  // not a level tier, and Combat Superiority's own derivedStat slot is
  // already claimed by maneuverChoiceCount's tiers on the SAME row — one
  // nullable String column cannot name both, so this is read directly (a
  // non-empty list IS the trigger), never matched by a derivedStat name.
  // Empty (the default) means "no such axis" for every row but Combat
  // Superiority.
  saveDcAbilities String[] @default([])

  // A passive, always-on grant — proficiency or a flat numeric bonus — the
  // row's prose promises but no other descriptor column can express (#1691;
  // the proving case is Life Domain's 2014 "Bonus Proficiency" row, which
  // said "you gain heavy armor proficiency" and granted nothing). Validated
  // seed-time against the SAME FeatImprovement vocabulary/zod schema a taken
  // feat's `improvements` snapshot uses (lib/srd/feats.ts's
  // featImprovementSchema/FEAT_IMPROVEMENT_TARGETS) — reused, not forked, so
  // a target added for feats is usable here with no second declaration.
  // #1682's SpeciesTrait.improvements is the sibling of this column, reusing
  // the same read-time evaluator (deriveImprovementBonuses/
  // deriveImprovementProficiencies).
  improvements Json?

  // A row-declared list of while-active buffs a "toggle" resolverKind
  // activates (#1686): [{ key, target, modifier, duration, minLevel?,
  // clearOn?, endReminder?, resistDamageTypes?, rollEffects? }]. Distinct from
  // buffTarget/buffModifier above (#900 C2b's single flat modifier, applied by
  // a cast) — this column carries a LIST, each entry independently
  // level-gated (minLevel) and able to carry resistance/roll-effect grants a
  // single flat modifier can't express (Rage needs both). `modifier` is
  // #1685's ResourceTotalFormula OR a tier array (ASCENDING minLevel,
  // last-match-wins, same invariant as resourceTotals/derivedStatTiers) —
  // evaluateBuffModifier (lib/classes/class-feature-rows.ts) is the one place
  // this vocabulary is interpreted. Validated seed-time
  // (classFeatureSeedSchema); `target` may equal the buff's own `key` for a
  // marker buff with no numeric effect (Elemental Attunement's shape).
  // `clearOn` (#1688) is a list of equip-time trigger keys (CLEAR_ON_TRIGGERS)
  // copied onto the instantiated ActiveBuff and matched against the equip
  // hook's own raised triggers (equipClearTriggers) — the metadata path Mage
  // Armor's equip-driven true-end (#363) now rides too (buffTarget
  // "acUnarmoredBase" -> clearOn ["equipBodyArmor"], set at cast time via
  // BUFF_TARGET_CLEAR_ON).
  effectBuffs Json?

  // Condition keys this feature grants immunity to, once its own level/
  // edition gate is met (#1121) — read together with the two columns below.
  // A plain String[] (mirrors saveDcAbilities), not nested in effectBuffs:
  // Beguiling Defenses/Nature's Ward are UNCONDITIONAL (no gating buff), so
  // forcing them through the buff-only effectBuffs list would need a fake
  // always-active buff for a feature the player never toggles.
  conditionImmunities                  String[] @default([])
  // Gates `conditionImmunities` on a buff of this key currently being active
  // (#1121) — e.g. Mindless Rage names "rage" (the Barbarian base-class Rage
  // row's own effectBuffs key), so the immunity applies only while raging.
  // Absent/null = unconditional (Beguiling Defenses, Nature's Ward).
  conditionImmunitiesRequireActiveBuff String?
  // What happens to an EXISTING matching condition when the gating buff above
  // STARTS (#1121, PHB'14 p.49 / SRD 5.2): "clear" permanently removes it
  // (2024 Mindless Rage — entering Rage ends Charmed/Frightened outright);
  // "suspend" removes it but restores it when the gating buff ENDS (2014
  // Mindless Rage — the condition is suspended, not cured, for the rage's
  // duration). Meaningless without conditionImmunitiesRequireActiveBuff;
  // applyRowDrivenActionInTx's toggle branch (routes/character/actions.ts) is
  // the one place this vocabulary is interpreted, alongside
  // conditionImmunitiesFromRows (lib/classes/class-feature-rows.ts) for the
  // read-time immune SET itself.
  conditionImmunitiesOnBuffStart       String?

  // NULLS NOT DISTINCT is hand-written in the migration (Prisma's DSL cannot
  // express it) — subclassId is nullable and base-class features are the
  // majority of rows, so without it two identical (fighter, NULL, "Second
  // Wind", EDITION_2024) rows would both insert.
  @@unique([classId, subclassId, name, edition])
  // The read path (#1524) joins on subclassId alone; the compound unique
  // above is classId-prefixed and cannot serve it.
  @@index([subclassId])
}

// Seeded home for the per-class AND per-background starting-equipment
// packages (#1519/#1533 classes; #1565 backgrounds), read at both read sites
// (GET /api/reference, character-create.ts) through mapStartingEquipmentPackage
// (#1534) — STARTING_EQUIPMENT, the TS module this table replaced, no longer
// exists. Relational, not a JSON blob (settled on #1519, not re-opened here):
// the nesting IS the content — group -> option -> (fixed items and/or open
// picks) plus a dice-expression gold alternative — and a JSON blob would put
// catalogName/weaponClass references beyond zod's reach (#1247/#1408).
// `edition` is NON-NULLABLE: there is no edition-neutral starting package, and
// a nullable column here is exactly how a 2014 package would silently serve a
// 2024 character — the bug #1519 was filed for, which #1534 relocated from a
// TS module into rows and #1535 finally fixed by authoring the real SRD 5.2
// packages. With `edition` NOT NULL, @@unique([classId, edition]) needs no
// NULLS NOT DISTINCT clause (contrast ClassFeature's nullable-subclassId trap).
//
// classId/backgroundId (#1565): a background's 2024 equipment shape (one
// choice group, lettered options, per-option GP) is structurally identical to
// a class's, so this row is reused rather than growing a second Background-
// EquipmentPackage/Group/Option/Item/OpenPick family — mapStartingEquipmentPackage
// needs no change at all. Exactly one of the two FKs is set per row, enforced
// by a hand-written CHECK constraint (20260801120000_starting_equipment_package_background,
// same Prisma-DSL-has-no-@@check gap as the gold-dice-jointly-null check
// above) rather than trusting every future write path to honour it.
model StartingEquipmentPackage {
  id           String          @id @default(uuid())
  classId      String?
  class        CharacterClass? @relation(fields: [classId], references: [id], onDelete: Cascade)
  backgroundId String?
  background   Background?     @relation(fields: [backgroundId], references: [id], onDelete: Cascade)
  // Mirror of CharacterClass.name / Background.name (whichever FK is set),
  // carried ONLY so staleCatalogRowsWhere/startingEquipmentStaleWhere can
  // partition this family's prune by (identity, edition) — that helper filters
  // on a scalar `name`/`key` column on the row itself and cannot build a
  // relation filter. Every LOOKUP goes through classId/backgroundId; nothing
  // may key on this column (#1388/#1529: display-name keying is what we are
  // moving away from). The prune partitions class rows (classId not null) and
  // background rows (backgroundId not null) into two independent sweeps —
  // see seed-starting-equipment.ts's pruneStaleClassPackages/
  // pruneStaleBackgroundPackages — so a `notIn: []` empty-partition trap on
  // one family can never delete the other's rows.
  name         String
  edition      RulesEdition

  // Nullable (#1564 commit 3): PHB'24 has no roll-for-gold rule at all — NULL
  // states that truthfully ("this package has no dice alternative"), where
  // 0/0/0 would read as "roll zero gold", the same class of lie as encoding a
  // flat 155 GP as {1,1,155}. Jointly null, never partially — a package
  // either has all three or none — ENFORCED by a hand-written CHECK
  // constraint (20260731160000_starting_equipment_package_gold_dice_check;
  // Prisma's DSL has no `@@check` attribute, same DSL gap as the schema's
  // NULLS NOT DISTINCT indexes), not just a convention mapGold's non-null
  // assertions rest on. Every EDITION_2014 CLASS package keeps its existing
  // non-null values; every background package (both editions, #1565) is
  // NULL here too — backgrounds have no roll-for-gold rule in either
  // edition, only a fixed/per-option GP amount. resolveStartingGold
  // (character-create.ts) rejects rather than computing when handed a
  // NULL-dice package, since PHB'24 (and every background) reaches its gold
  // through a lettered StartingEquipmentOption.gold instead (#1564 commit 2).
  goldDiceCount  Int?
  goldDiceFaces  Int?
  goldMultiplier Int?

  groups StartingEquipmentGroup[]

  @@unique([classId, edition])
  @@unique([backgroundId, edition])
}

model StartingEquipmentGroup {
  id        String                   @id @default(uuid())
  packageId String
  package   StartingEquipmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  // Load-bearing, not cosmetic: the creation client indexes options
  // positionally (collectGroupRefs), and rows come back in arbitrary order
  // without an explicit orderBy — assigned by array index at seed time from a
  // nested literal, so it's deterministic by construction (#1545's lesson).
  position  Int
  label     String

  options StartingEquipmentOption[]

  @@unique([packageId, position])
}

model StartingEquipmentOption {
  id       String                 @id @default(uuid())
  groupId  String
  group    StartingEquipmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  position Int
  label    String
  // GP this option grants on top of (or instead of) its items (#1564). Forced
  // by PHB'24's shape, not a preference: every non-final option across all
  // twelve 2024 class packages carries 4-28 GP, and the flat final option
  // (50-155 GP) is just an option with this set and no items — same
  // presentation the book itself uses, so no separate "gold mode" per option.
  // Every EDITION_2014 option is 0 (2014's gold is the package-level dice
  // roll, StartingEquipmentPackage.goldDiceCount/Faces/Multiplier, untouched).
  gold     Int                    @default(0)

  items     StartingEquipmentItem[]
  openPicks StartingEquipmentOpenPick[]

  @@unique([groupId, position])
}

model StartingEquipmentItem {
  id          String                  @id @default(uuid())
  optionId    String
  option      StartingEquipmentOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  position    Int
  // NAME reference, deliberately not a FK to Item: resolveFixedItems looks a
  // ref up against Pack FIRST and falls through to Item, so an Item FK would
  // make "Dungeoneer's Pack" unexpressible. The seed validator checks
  // ITEMS ∪ PACKS instead (assertSeedContentValid).
  catalogName String
  quantity    Int                     @default(1)

  @@unique([optionId, position])
}

model StartingEquipmentOpenPick {
  id                String                  @id @default(uuid())
  optionId          String
  option            StartingEquipmentOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  position          Int
  label             String
  // Named after ItemWeaponDetail's columns, which openPickFilterError
  // compares against — NOT after the wire field. The wire's OpenPickFilter
  // (renamed from WeaponPoolFilter, #1564 — it filters more than weapons now)
  // calls the second one `range`; mapStartingEquipmentPackage's mapOpenPick
  // (backend lib/inventory/starting-equipment-package.ts, #1534) is the mapper
  // that renames it. If you rename either side, rename the mapper in the same diff.
  weaponClass       WeaponClass? // null = any
  weaponRange       WeaponRange? // null = any
  // Non-weapon filter axis (#1564): "musical instrument" / "artisan tool"
  // pool, e.g. the Bard's "musical instrument of your choice". Mirrors
  // Item.toolCategory, which openPickFilterError compares against.
  toolCategory      ToolCategory? // null = not tool-filtered
  // True when this pick isn't a free choice at all but must match ONE OF the
  // character's own creation tool choices (creationToolProfs) — Monk's
  // "Artisan's Tools or Musical Instrument chosen for the tool proficiency
  // above". A free pick would let a Monk take an instrument with no
  // proficiency in it, which the book does not permit. Also serves the
  // Soldier background's "Gaming Set (same as above)" (#1565) — same
  // mechanism, no second one built for it.
  boundToToolChoice Boolean                 @default(false)
  quantity          Int                     @default(1)

  @@unique([optionId, position])
}

model Background {
  id                 String        @id @default(uuid())
  name               String
  skillProficiencies String[]
  toolProficiencies  String[]      @default([])
  // Tool proficiency CHOICE — mirrors CharacterClass.toolChoices/
  // toolChoiceCount exactly (#1779): a background can grant a choice (PHB'14
  // and PHB'24 Soldier/Noble's "one type of gaming set") as well as a fixed
  // tool. Edition-invariant columns — both editions' backgrounds feed the
  // same pair; only the seeded content per row differs. No page cited: same
  // "unpaged over invented" rule as starting-equipment.ts's Charlatan/Noble.
  toolChoices        String[]      @default([])
  toolChoiceCount    Int           @default(0)
  // PHB'24: each background grants +3 ability points across these three abilities
  // (2+1 or 1+1+1) plus one Origin feat. Empty/null for spec-less 2014 legacy rows.
  abilityChoices     String[]      @default([])
  originFeatId       String?
  originFeat         Feat?         @relation(fields: [originFeatId], references: [id], onDelete: SetNull)
  // NULL = valid in both editions; only a genuinely diverging background forks
  // into one row per edition sharing this name (#1306). The migration's unique
  // index on (name, edition) uses NULLS NOT DISTINCT so two NULL-edition rows
  // sharing a name are still rejected — see resolveEditionRow, the single
  // place the fallback ordering lives.
  edition            RulesEdition?

  selections                CharacterBackground[]
  // Back-relation only — not a column, appears on no payload unless included
  // (#1565's StartingEquipmentPackage reuse, see that model's own comment).
  startingEquipmentPackages StartingEquipmentPackage[]

  @@unique([name, edition])
}

// --- Per-character selections -----------------------------------------------
// Each links a Character to a catalog row (optionally — null means
// homebrew, no baseline) and carries its own `name`, which defaults to the
// catalog entry's name at creation but is free to drift independently.

model CharacterRace {
  id                    String          @id @default(uuid())
  characterId           String          @unique
  character             Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // Display-name snapshot, defaulting from the resolved species/variant at
  // creation (character-create.ts's raceSelectionCreateInput) but free to
  // diverge — same "catalog default, no live reference" shape as the other
  // per-character selection models (CharacterClass/CharacterBackground).
  name                  String
  // The mechanical anchor (#1679, epic #1518) since #1684 pruned the flat
  // `Race` model — every API-created character has one (POST /api/characters
  // requires speciesId), but the column stays nullable for the same reason
  // CharacterBackground.backgroundId is: a homebrew/fixture row with no
  // catalog anchor is still a legal CharacterRace. variantId is set only for
  // a variant-bearing species — character-create.ts's resolveSpeciesSelection
  // requires one whenever the chosen species has variant rows.
  speciesId             String?
  species               Species?        @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  variantId             String?
  variant               SpeciesVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Drifting display snapshot of the chosen variant's name — same "defaults
  // from the catalog, free to diverge" shape as `name` above. NULL when no
  // variant was chosen (variantless species or a homebrew/fixture row with no
  // speciesId).
  variantName           String?
  // Provenance snapshot of the ability increases actually APPLIED (owner-
  // approved 2026-08-03), written by resolveSpeciesGrants (character-create.ts,
  // #1681) — [] for a 2024 character or a species with no increases in its
  // merged spec. Makes the bake auditable, unlike the background ability
  // spread (#1130), which has no equivalent record. The scores themselves
  // stay baked with no reversible delta — species is immutable post-creation
  // (no species transaction endpoint, absent from PATCH), so there is
  // nothing for a delta to ever reverse, and no LEVEL_GATED_RECONCILERS
  // entry follows for the same reason: this state's legal maximum is fixed
  // at creation, never revisited by level.
  abilityBonuses        Json            @default("[]")
  // #1683: the Int/Wis/Cha casting-ability choice a 2024 lineage/legacy makes
  // WHEN GAINED (PHB'24 "choose the ability when you select the lineage") —
  // snapshotted here, not on SpeciesGrantedSpell, because the row is shared
  // catalog content and the choice is per-character. Plain string, not the
  // AbilityName wire type (no Ability enum in this schema, same convention as
  // SubclassGrantedSpell.castingAbility) — validated against the six lowercase
  // names at read time (deriveGrantedCastingAbility's own fallback-to-wisdom
  // guard covers a corrupt value). NULL for a 2014 character (no 2014 subrace
  // has this choice), a species/variant with no spell grant, or before #1683's
  // picker runs. Immutable post-creation — same reasoning as abilityBonuses
  // above, no LEVEL_GATED_RECONCILERS entry.
  castingAbility        String?
  // #1689: provenance snapshot of the species-granted CREATION CHOICES applied
  // — sibling of abilityBonuses above, same "audit-only, not the source of
  // truth" role as variantName. The functional grant lives elsewhere
  // (speciesSkills fold into the character's normal skillProficiencies;
  // the cantrip lands in Character.spellcasting.spells, source:"species") —
  // these two columns exist only so the choice is inspectable without
  // re-deriving it from the mutable spellcasting blob. [] / null for a
  // species with no choice-bearing trait, or every 2024 species this slice
  // (the mechanism is edition-neutral; 2024 content is #1690's).
  speciesSkills         String[]        @default([])
  speciesCantripName    String?
  // #1690: provenance snapshot of a species-granted Origin feat pick (Human's
  // Versatile) — sibling of speciesCantripName above, same "audit-only" role.
  // The functional grant lives on Character.resources.advancements as a
  // slot-exempt AdvancementEntry (the SAME snapshot shape the background's
  // Origin feat bakes via buildOriginEntry, #1130), never re-derived from
  // this column. NULL for every species with no chooseOriginFeat trait.
  speciesOriginFeatName String?
}

model CharacterBackground {
  id           String      @id @default(uuid())
  characterId  String      @unique
  character    Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  backgroundId String?
  background   Background? @relation(fields: [backgroundId], references: [id], onDelete: SetNull)
  name         String
}

// One-to-many (not @unique on characterId): a character can hold several
// class entries, which is what multiclassing needs. v1 always creates
// exactly one entry per character (position 0).
model CharacterClassEntry {
  id          String          @id @default(uuid())
  characterId String
  character   Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  classId     String?
  class       CharacterClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  name        String
  level       Int             @default(1)
  // Drifting subclass display name — free to diverge from the catalog row's
  // name (same pattern as the `name` field coexisting with `classId`). Set on
  // creation or via POST …/class/transactions. Null = no subclass chosen yet.
  subclass    String?
  // Nullable FK to the Subclass catalog. Null means homebrew or no subclass.
  subclassId  String?
  subclassRef Subclass?       @relation(fields: [subclassId], references: [id], onDelete: SetNull)
  position    Int             @default(0)
}

enum ItemCategory {
  weapon
  armor
  consumable
  gear
}

// Who authored an Item row (#1645, epic #1644). GLOBAL rows are seeded catalog
// content with exactly one writer; CAMPAIGN rows are DM-authored and merged in
// from CampaignItem by #1646. Adding USER needs no redesign (see Item.scopeKey)
// but is NOT free: Item_scope_key_agreement_check enumerates the scopes, so a
// new member without a matching CHECK branch rejects every insert.
enum ItemScope {
  GLOBAL
  CAMPAIGN
}

// The six 5e magic-item rarity tiers (DMG p. 135). Rules data + gp values live
// in lib/srd.ts (ITEM_RARITIES); this is only the persisted column domain.
enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  VERY_RARE
  LEGENDARY
  ARTIFACT
}

enum ArmorCategory {
  light
  medium
  heavy
  shield
}

// Paper-doll equip slots (#565). A worn/wielded item occupies exactly one slot
// per row; RING has capacity 2, every other slot capacity 1. A two-handed weapon
// sits in MAIN_HAND and locks OFF_HAND (never a second row). Weapons/body armor
// derive their eligible slots from detail data; gear declares its slot via the
// nullable Item.slot / InventoryItem.slot column (null = bag-only, not wearable).
enum EquipSlot {
  MAIN_HAND
  OFF_HAND
  BODY
  HEAD
  NECK
  CLOAK
  HANDS
  WRISTS
  BELT
  FEET
  RING
}

// Weapon proficiency group — used by the starting-equipment package resolver
// to filter open picks like "any martial weapon". Nullable on both detail
// tables: homebrew weapons (custom acquire) may omit classification without
// breaking anything; open-pick validation simply skips weapons whose value
// is null.
enum WeaponClass {
  simple
  martial
}

// Whether a weapon is wielded in melee or at range — combined with
// WeaponClass for finer open-pick filters like "any martial melee weapon"
// (Barbarian). Nullable for the same reasons as WeaponClass above.
enum WeaponRange {
  melee
  ranged
}

// Tool-proficiency category (SRD 5.1 / SRD 5.2 — both editions' tools pages
// list all three categories: Artisan's Tools, Gaming Set, Musical Instrument)
// — mirrors backend lib/srd/tools.ts's TOOLS list (#1564). Lets a starting-
// equipment open pick filter on "is this a musical instrument" as a COLUMN
// the validator reads, rather than the DB-driven equipment resolver reaching
// into a rules TS module. Only the items that are actual tools carry this on
// Item (the ten instruments,
// Herbalism Kit, Thieves' Tools) — most of TOOLS has no Item row at all.
enum ToolCategory {
  artisan
  gamingSet
  musicalInstrument
  other
}

// Lifecycle of a play session: active while in progress, ended when the
// player wraps up and optionally awards XP.
enum SessionStatus {
  active
  ended
}

// Item-capability discriminator (#545). Reserves the full A–E menu; only
// passiveBonus is implemented this slice — the rest are forward-declared so the
// side-table column set + adapter don't churn when they land.
enum CapabilityKind {
  passiveBonus
  castSpell
  charges
  grant
  activatedEffect
}

// Recharge period of a castSpell capability's item resource (#528). atWill is
// unlimited (no use tracking). perDay dawn/dusk approximate to a long rest.
// charges (#555) spends the item's shared charge pool (chargeCost per cast)
// instead of a per-capability counter.
enum CapabilityCastResource {
  perRestShort
  perRestLong
  perDayDawn
  perDayDusk
  atWill
  charges
}

// Whether a castSpell DC / attack bonus is a fixed item value or resolves to the
// wielder's own spell save DC / spell attack (#528).
enum CapabilityCastStatMode {
  fixed
  wielder
}

// Which derived stat a passiveBonus capability targets. Only scalar targets are
// summed into the modifier channel today; ac (#383) + dice→damage (#526C) defer.
enum CapabilityTarget {
  ac
  attack
  damage
  save
  skill
  abilityScore
  spellAttack
  spellDc
  initiative
  speed
  maxHp
}

// How a passiveBonus applies: add to the target's modifier channel, or set an
// absolute floor/override (setTo not yet consumed in derivation this slice).
enum CapabilityOp {
  add
  setTo
}

// How an activatedEffect capability (#543) is triggered in play. commandWord is
// a no-action verbal toggle; the rest mirror 5e's action economy.
enum ActivationType {
  action
  bonus
  reaction
  commandWord
}

// How long an activatedEffect's seeded self-buff rides the holder (#543). Maps to
// the ActiveBuff duration axis: whileActive = manual toggle-off, untilRest = a rest.
enum ActivatedDuration {
  whileActive
  untilRest
}

// The recharge model for an activatedEffect's uses (#543). perRest/perDay bound
// the uses per period; atWill is unlimited (never spends). charges (#555) spends
// the item's shared charge pool (chargeCost per activation).
enum ItemResourceKind {
  perRest
  perDay
  atWill
  charges
}

// The period an ItemResourceKind recharges over (#543). short|long pair with
// perRest; dawn|dusk with perDay (approximated to a long rest on reset).
enum ItemResourcePeriod {
  short
  long
  dawn
  dusk
}

// Attunement prerequisite category (5e "requires attunement by a …"). value
// carries the specific class/species/alignment; spellcaster needs no value.
enum AttunementPrereqKind {
  class
  spellcaster
  species
  alignment
}

// Spell schools per the 5e SRD. Mirrors frontend/src/types/character.ts
// SpellSchool — the two must stay in sync.
enum SpellSchool {
  abjuration
  conjuration
  divination
  enchantment
  evocation
  illusion
  necromancy
  transmutation
}

// Action catalog — seeded with universal 5e combat actions (Dodge, Dash, etc.)
// and class-specific abilities (Rage, Second Wind, Flurry of Blows, etc.).
// Holds DISPLAY + GATING data only. Executable mechanics are hardcoded in
// backend/src/lib/actions.ts (ACTION_EFFECT_FN keyed by `key`) — the same
// split as CLASS_RESOURCE_FN vs. the DerivedResource descriptions here.
// Adding a new action = append a row to seed.ts + add the effect fn in
// actions.ts. No migration needed for new actions; only new columns need one.
model Action {
  id          String @id @default(uuid())
  key         String // stable machine key, e.g. "rage" | "dodge"
  name        String // display label
  description String

  // Which economy slot this action consumes on the character's turn.
  cost ActionCost

  // Gating — universal actions are available to everyone; class/subclass/level
  // actions are gated by the character's class entry.
  universal     Boolean @default(false)
  grantClass    String? // lowercase class name, e.g. "fighter"
  grantSubclass String? // lowercase subclass name (optional, for subclass-only abilities)
  grantLevel    Int? // minimum character level for this action to appear

  // Optional scalar resource-spend hint — used by deriveActions to determine
  // `enabled` (e.g. Rage costs 1 "rage"; Flurry of Blows costs 1 "ki" or 1
  // "focus" depending on edition, #1500). No program, just two columns that
  // let deriveActions check remaining > amount.
  resourceKey    String? // matches DerivedResource.key, e.g. "rage"
  resourceAmount Int? // units required; null means no resource check needed

  // NULL = valid in both editions (#1306) — still true for every class row.
  // Every `universal: true` row is now forked (#1430): each `description` is a
  // transcription from ONE named document, so a shared row could only cite
  // "SRD 5.1 and SRD 5.2" and an ambiguous citation is a bug. That is why the
  // business key is (key, edition) rather than plain `key` — `key` is
  // edition-stable identity, so the 2024 Magic row keeps `key: "castSpell"`.
  edition RulesEdition?

  // NULLS NOT DISTINCT is hand-written in the migration (Prisma's DSL cannot
  // emit it), so a class row's NULL edition still admits at most one row per
  // key — see 20260729120000_widen_action_key_edition.
  @@unique([key, edition])
}

enum ActionCost {
  action
  bonusAction
  reaction
  free
  special
}

// Generic granted-ability catalog — source discriminates ("maneuver" for Battle
// Master, "shadowArts" for Way of Shadow, "channelDivinity", plus subclass
// choose-N option sources). Embeds min level, save ability, EffectSpec +
// AbilityCost. Provenance pointer in ManeuverEntry.maneuverId.
model GrantedAbility {
  id          String  @id @default(uuid())
  name        String
  source      String  @default("maneuver")
  description String
  minLevel    Int     @default(3) // minimum level to learn/use
  alwaysKnown Boolean @default(false) // always known (bypasses the choice cap)

  // Battle Master maneuver placement/action metadata (source "maneuver" only).
  // placement routes the session UI: attackRoll | damageRoll | reaction | effect
  // | attackOption. actionSlot is the economy slot consumed (bonusAction/reaction),
  // null when none. selfTempHp = Rally (die + Cha mod as self temp HP).
  placement  String?
  actionSlot String?
  selfTempHp Boolean @default(false)

  // Embedded AbilityCost (F2/F3) — focus/superiority-die pool spend, or a
  // spell-slot spend. kind "none" = free.
  costKind    String? // "none" | "pool" | "slot"
  costPoolKey String? // e.g. "focus" — "pool" only
  costBase    Int? // "pool": base pool cost. "slot" (#1687): minimum slot level (AbilityCost's minLevel) — reused rather than a dedicated costMinSlotLevel column since a row is never both kinds at once.
  costPerStep Int? // additional units per scaling step — "pool" only

  // Embedded EffectSpec (F1) — same flat columns as Spell. saveAbility doubles
  // as the ability's DC save ability.
  effectKind         String?
  effectDiceCount    Int?
  effectDiceFaces    Int?
  effectDieSource    String? // e.g. "superiorityDice" — resolves faces from DerivedClassInfo, supersedes effectDiceFaces
  effectModifier     Int?
  damageType         String?
  attackType         String?
  saveAbility        String?
  saveEffect         String?
  upcastDicePerLevel Int?
  cantripScaling     Boolean @default(false)

  // Passive-modifier (buff) effect: applies a flat modifier to a skill/stat
  // target while the granting concentration holds. null = not a buff.
  buffTarget   String?
  buffModifier Int?

  // The row-declared while-active buff list (#1686) — see ClassFeature.effectBuffs'
  // own comment for the shape/evaluator. No maneuver/GrantedAbility row
  // populates this yet; added here so a future "toggle" GrantedAbility (e.g. a
  // Battle Master maneuver with a while-active rider) needs no second migration.
  effectBuffs Json?

  // Declarative activation-time gates (#1688) — see ClassFeature.activationRequires'
  // own comment for the vocabulary/evaluator. No maneuver row populates this
  // yet (no maneuver has an armor/shield or requiresActiveBuff constraint);
  // added here for schema symmetry so a future GrantedAbility with one needs
  // no second migration.
  activationRequires Json?

  // NULL = valid in both editions; a diverging maneuver / shadow art / channel
  // divinity / subclass-choice option forks into one row per edition sharing
  // this name (#1306, widened by #1415 ahead of #1313). The migration's unique
  // index on (name, edition) uses NULLS NOT DISTINCT so two NULL-edition rows
  // sharing a name are still rejected — see resolveEditionRow, the single place
  // the exact/NULL fallback ordering is expressed.
  edition RulesEdition?

  // `source` is deliberately NOT in the key: a name identifies exactly one row
  // across maneuver/shadowArts/channelDivinity/choice sources, and every
  // name-keyed lookup relies on that. Widening by `edition` alone preserves it.
  @@unique([name, edition])
}

// Feat catalog — seeded from a curated SRD subset. Provenance pointer in
// AdvancementEntry.featId (nullable so custom feats have no catalog row).
// abilityOptions/abilityIncrease drive the half-feat ability bump (e.g.
// Resilient: +1 to one chosen ability). Empty abilityOptions = not a half-feat.
// PHB'24 feat categories: Origin (background-granted, no level req), General
// (level 4+, +1 ability), Fighting Style, and Epic Boon (level 19+).
enum FeatCategory {
  origin
  general
  fighting_style
  epic_boon
}

model Feat {
  id                String        @id @default(uuid())
  name              String
  description       String
  prerequisite      String?
  category          FeatCategory  @default(general)
  levelPrerequisite Int? // General ⇒ 4, Epic Boon ⇒ 19 (PHB'24)
  repeatable        Boolean       @default(false)
  abilityOptions    String[]      @default([]) // abilities the player may raise by abilityIncrease
  abilityIncrease   Int           @default(0) // usually 1 for half-feats
  improvements      Json          @default("[]") // FeatImprovement[]: { target, amount, perLevel? }
  // NULL = valid in both editions; a diverging feat (e.g. Alert) forks into one
  // row per edition sharing this name (#1306). The migration's unique index on
  // (name, edition) uses NULLS NOT DISTINCT so two NULL-edition rows sharing a
  // name are still rejected — see resolveEditionRow, the single place the
  // exact/NULL fallback ordering is expressed.
  edition           RulesEdition?
  // Class-name scope (#1495): [] = any class with the feature may take this
  // feat (2024's Fighting Style feats, and every non-fighting_style feat).
  // Non-empty restricts it to those classes, matched case-insensitively —
  // PHB'14's per-class Fighting Style subset (Fighter all six; Paladin
  // Defense/Dueling/Great Weapon Fighting/Protection; Ranger
  // Archery/Defense/Dueling/Two-Weapon Fighting). Read through
  // fightingStyleFeatOfferedForClasses (lib/srd/feats.ts), the one
  // edition-parameterized rule function — never a second column and never
  // `=== "EDITION_…"` (subclassGateLevel precedent, #1527).
  classes           String[]      @default([])

  // Backgrounds that grant this feat as their Origin feat (PHB'24).
  originForBackgrounds Background[]

  @@unique([name, edition])
}

// Entitlement supertype (#1796, epic #1795 1/6). One row per piece of
// catalog content regardless of `kind`, carrying WHO owns it and WHO may see
// it — the concern every per-kind table (Spell today; Item eventually) used
// to duplicate for itself (Spell.ownerId, #1784). Deliberately carries NO
// back-relation to any per-kind table (no `spell Spell?` field here): a
// generic supertype that named its own subtypes would defeat the point of
// being generic the moment a second kind (Item) joins it. The per-kind table
// points UP at its CatalogEntry via a bare scalar instead (see Spell.
// catalogEntryId's own comment).
enum CatalogKind {
  SPELL
}

// GLOBAL = seeded system content, visible to everyone. USER = a player's
// homebrew, visible only to them (until granted into a campaign, #1795 later
// slices). CAMPAIGN = a DM's homebrew, scoped to their campaign.
enum CatalogScope {
  GLOBAL
  USER
  CAMPAIGN
}

model CatalogEntry {
  id    String       @id @default(uuid())
  kind  CatalogKind
  scope CatalogScope

  // Exactly one of ownerUserId/ownerCampaignId is set, matching `scope`
  // (GLOBAL: neither) — a CHECK constraint enforces this; Prisma's DSL can't
  // express a cross-column conditional, so it's hand-written into the
  // migration (see that file's own comment, same shape as Item's
  // scope/scopeKey agreement CHECK).
  ownerUserId String?
  ownerUser   User?   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  ownerCampaignId String?
  ownerCampaign   Campaign? @relation(fields: [ownerCampaignId], references: [id], onDelete: Cascade)

  name    String
  edition RulesEdition

  // Fork provenance (#1795 later slices: forking a GLOBAL/granted entry into
  // your own USER/CAMPAIGN scope to customize it). SetNull, not Cascade: the
  // origin being deleted must not take every fork of it down too — a fork
  // stands on its own copy of the content the moment it exists.
  forkedFromId String?
  forkedFrom   CatalogEntry?  @relation("Fork", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        CatalogEntry[] @relation("Fork")

  grants CatalogGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Business-key uniqueness: NULLS NOT DISTINCT so two GLOBAL (both owner
  // arms null) rows can't share a (kind, name, edition), matching Spell's
  // pre-#1796 (name, edition, ownerId) key. Hand-written into the migration
  // — same Prisma-DSL limitation as Spell's own former unique index (Prisma
  // 7.8 rejects the `nullsNotDistinct` attribute).
  @@unique([kind, scope, ownerUserId, ownerCampaignId, name, edition])
  @@index([kind, scope])
  @@index([ownerUserId])
  @@index([ownerCampaignId])
  @@index([forkedFromId])
}

// A CAMPAIGN's or DM's grant of a USER/GLOBAL catalog entry into a specific
// campaign, so its players can see content that isn't theirs or the system's
// (#1795 later slices resolve the read path through this join). One entry
// may be granted into many campaigns; one campaign may hold many grants —
// hence the plain join table rather than a column on CatalogEntry.
model CatalogGrant {
  id String @id @default(uuid())

  catalogEntryId String
  catalogEntry   CatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([catalogEntryId, campaignId])
  @@index([campaignId])
}

// Baseline spell catalog — same catalog-table role as Item above. Seeded from
// a curated SRD subset (prisma/seed.ts). Never referenced by a direct FK on
// Character; provenance lives in the per-character spellcasting JSON blob's
// SpellEntry.spellId field, nullable so homebrew spells have no catalog row.
// All per-spell mechanical data lives here rather than on a *Detail table —
// spells are flat (school/level/effect/scaling) rather than category-
// polymorphic like items, so no detail table split is needed.
model Spell {
  id            String      @id @default(uuid())
  name          String
  level         Int // 0 = cantrip
  school        SpellSchool
  castingTime   String
  range         String
  duration      String
  description   String
  concentration Boolean     @default(false)
  ritual        Boolean     @default(false)

  // Spell components for spellbook display + future component checks.
  // { verbal: bool, somatic: bool, material: bool, materialDescription?: string }
  components Json?

  // Structured effect data for auto-rolling at cast time (RollSpec-shaped,
  // mirrors ItemWeaponDetail / ItemConsumableDetail). null = utility spell.
  effectKind         String? // "damage" | "heal" | "buff" — null means utility (no roll)
  effectDiceCount    Int?
  effectDiceFaces    Int?
  effectModifier     Int? // flat bonus added after dice (e.g. +3 in "3d4+3")
  damageType         String? // "fire" / "radiant" / etc. — for damage spells
  attackType         String? // "attack" | "save" | null
  saveAbility        String? // ability the target saves with, e.g. "dexterity"
  // Passive-modifier (buff) effect (#363) while active. `buffModifier` is the
  // ABSOLUTE value the AC target reads, never a delta over the base: "ac" is a
  // flat +N add (Shield of Faith 2), "acUnarmoredBase" is the full unarmored base
  // (Mage Armor 13 → 13+Dex, NOT 3), "acFloor" is the floor (Barkskin 17).
  // Duration derives from `concentration` (true → concentration, else
  // while-active). null = not a buff.
  buffTarget         String?
  buffModifier       Int?
  // For save-based damage spells: "half" = half damage on a successful save
  // (Fireball), "none" = no damage on save. null for attack spells / utility.
  saveEffect         String?
  // Extra effect dice added per slot level cast above the base level (null =
  // spell has no upcast scaling — Fireball adds 1d6 per upcast level).
  upcastDicePerLevel Int?
  // Cantrip damage scales with character level (5/11/17 thresholds) per 5e rules.
  cantripScaling     Boolean @default(false)

  // Subclasses that grant this spell for free (#898).
  grantedBy        SubclassGrantedSpell[]
  // Species/variants that grant this spell for free (#1679's table; no rows yet).
  speciesGrantedBy SpeciesGrantedSpell[]
  // Subclasses whose list-expansion adds this spell to the choosable pool
  // (#1631) — a picker-only widening, never a free grant (see grantedBy above).
  listExpandedBy   SubclassSpellListExpansion[]
  // Class-membership join (#1711 F2 of epic #1517) — replaces the old
  // `classes String[]` column. No `edition` filter needed on this side: a
  // 2014-fork Spell row and its 2024 sibling are separate Spell rows (Shape
  // 1, edition rides the parent row below), so each owns disjoint
  // SpellClass rows already.
  classMemberships SpellClass[]

  // NULL = valid in both editions; a diverging spell forks into one row per
  // edition sharing this name (#1710, foundation for epic #1517's 2014
  // catalog). Mirrors Feat's `edition` above: NULLS NOT DISTINCT on the
  // migration's unique index so two NULL-edition rows sharing a name are
  // still rejected — see resolveEditionRow, the single place the exact/NULL
  // fallback ordering is expressed. The existing ~109 seeded rows are SRD 5.2
  // text and are tagged EDITION_2024, not NULL — they're edition-specific
  // content (renamed spells, narrowed components), not rules that happen to
  // agree, so seedSpells defaults an untagged spells.ts entry to 2024 rather
  // than to the "shared" NULL Feat uses.
  edition RulesEdition?

  // Entitlement supertype (#1796, epic #1795 1/6): every Spell row — seeded
  // OR homebrew — is 1:1 with exactly one CatalogEntry, which is what now
  // carries ownership/scope (replacing the #1784 Spell.ownerId column this
  // migration drops). A bare scalar, deliberately with NO Prisma relation
  // field here: CatalogEntry carries no back-relation to Spell either (see
  // that model's own comment), which is what keeps the supertype closed to
  // future kinds (Item, …) instead of hard-coupling it to Spell specifically.
  // The FK constraint (ON DELETE CASCADE) is hand-written into the migration
  // — Prisma only emits one from an actual `@relation`, and this column
  // deliberately has none.
  catalogEntryId String @unique
}

// Spell↔class membership join (#1711, F2 of epic #1517's 2014 catalog fork).
// Replaces `Spell.classes String[]`: a single array column can't hold two
// editions' class lists when they diverge (SRD 5.2 reassigned/renamed
// spells), so membership moves to a queryable, homebrew-friendly join.
//
// No `edition` column — Shape 1 (settled here, referenced by #1495's
// identical join question): edition rides the parent Spell row, so a
// 2014-fork spell and its 2024 sibling are two separate Spell rows, each
// with its own disjoint SpellClass rows. onDelete: Cascade so a content
// slice's reseed pruning a stale Spell row never leaves an orphaned
// membership row behind.
model SpellClass {
  id        String @id @default(uuid())
  spellId   String
  spell     Spell  @relation(fields: [spellId], references: [id], onDelete: Cascade)
  className String // lowercase class name, e.g. "wizard"

  @@unique([spellId, className])
  // #1712 (folded in from #1711's review): className isn't the leading
  // column of the unique(spellId, className) index above, so the ?class=
  // route filter (classMemberships.some, spells.ts) can't use it — a
  // dedicated index before the 2014 content slices (#1713-#1721) multiply
  // the row count. See the hand-written migration's own comment for why this
  // needed a manual migration.sql rather than `prisma migrate dev`.
  @@index([className])
}

// Baseline equipment catalog, same role as Species/CharacterClass above: seeded
// from a small SRD subset (prisma/seed.ts) and never referenced directly by
// Character — only through InventoryItem.itemId, which is nullable, so
// editing/removing a catalog row never breaks an existing character's
// inventory. Mechanical fields specific to one category (damage dice, AC,
// an effect roll) live on the optional *Detail tables below rather than as
// nullable columns here — see those models' comments for why.
model Item {
  id           String        @id @default(uuid())
  scope        ItemScope     @default(GLOBAL)
  // Non-null uniqueness discriminator: "global" or "campaign:<campaignId>".
  // The rule is "a name is unique among GLOBAL rows only", and this is its only
  // expressible form here — @@unique([campaignId, name]) is SILENTLY wrong
  // because Postgres treats NULLs as distinct (two catalog rows named
  // 'Longsword' would both insert), and Prisma 7.8 rejects `nullsNotDistinct`.
  // Redundant with scope/campaignId by construction; item-scope.integration
  // .test.ts asserts the agreement. Extends to "user:<id>" unchanged.
  scopeKey     String
  campaignId   String?
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name         String
  category     ItemCategory
  weight       Float?
  cost         Json? // {cp,sp,gp,pp} — sell/buy default, player can override
  description  String?
  // Paper-doll slot for gear (#565). null = bag-only (not wearable). Weapons
  // and body armor derive their slot from detail data, so this is only set for
  // wearable gear (rings, cloaks, amulets, boots, etc.).
  slot         EquipSlot?
  // Tool-proficiency category (#1564) — set ONLY for the small set of Item
  // rows that ARE tools (the ten musical instruments, Herbalism Kit,
  // Thieves' Tools); null for everything else. Lets a StartingEquipmentOpenPick
  // filter "musical instrument" / "artisan tool" as a column read, never a
  // reach into lib/srd/tools.ts from the equipment resolver.
  toolCategory ToolCategory?

  // Promoted from CampaignItem (#1645, epic #1644). These are precisely what
  // the seeded catalog could not express: with no rarity, no attunement and no
  // capability rows, an Item could not BE a magic item. #1646 merges
  // CampaignItem into this table; seeding actual SRD magic items is separate
  // content work.
  rarity                ItemRarity?
  requiresAttunement    Boolean               @default(false)
  // null kind = attunable by anyone — distinct from requiresAttunement false.
  attunementPrereqKind  AttunementPrereqKind?
  attunementPrereqValue String?
  isUnique              Boolean               @default(false)
  // DM-private prep notes; never serialized into a player-facing response.
  // Meaningful only on CAMPAIGN rows — #1646 keys the scrub off scope.
  dmNotes               String?
  // Carried over because the campaign-item wire exposes both (serializeCampaignItem);
  // promoting them here keeps #1646 a pure data move rather than a wire change.
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  weaponDetail     ItemWeaponDetail?
  armorDetail      ItemArmorDetail?
  consumableDetail ItemConsumableDetail?
  capabilities     ItemCapability[]

  inventoryItems InventoryItem[]
  packContents   PackContent[]
  // Back-relation to the fronting ITEM CampaignEntity link (#380, re-parented
  // from CampaignItem by #1646). Only ever set on a CAMPAIGN-scoped row.
  link           CampaignItemLink?

  @@unique([scopeKey, name])
  @@index([campaignId])
}

// Typed 1:N capability side-table. Was CampaignItemCapability's column set
// verbatim before #1646 merged the two definition tables and copied every
// CAMPAIGN row across with a straight INSERT … SELECT keyed on it.
model ItemCapability {
  id     String @id @default(uuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  kind        CapabilityKind
  description String?

  // passiveBonus payload
  target    CapabilityTarget?
  op        CapabilityOp?
  value     Int?
  // Specific skill/ability/save key when target is skill|abilityScore|save.
  targetKey String?
  condition String?

  // Dice-valued bonus (round-trips now; consumed in the damage roll at #526C).
  valueDiceCount  Int?
  valueDiceFaces  Int?
  valueDamageType String?

  // castSpell payload (#528): the item grants a spell cast from the item itself.
  spellId           String? // catalog Spell.id provenance
  spellName         String? // snapshot for display without a catalog join
  spellLevel        Int?
  castLevel         Int? // slot level the item casts the spell at
  castResource      CapabilityCastResource?
  castUses          Int? // uses per recharge period (null = 1)
  castConcentration Boolean?
  dcMode            CapabilityCastStatMode?
  dcValue           Int?
  attackMode        CapabilityCastStatMode?
  attackValue       Int?

  // activatedEffect payload (#543). The inline while-active self-buff reuses the
  // target/op/value columns above; these add the activation + recharge model.
  activation        ActivationType?
  activatedDuration ActivatedDuration?
  resourceKind      ItemResourceKind?
  resourcePeriod    ItemResourcePeriod?
  resourceCharges   Int?
  // Free-text wall-clock duration ("10 minutes") surfaced as reminder text.
  durationText      String?

  // grant payload (#529): resistance/immunity/conditionImmunity/advantage/proficiency.
  grantType       String?
  grantOn         String?
  grantValueKind  String?
  grantValue      String?
  cantBeSurprised Boolean @default(false)

  // charges payload (#555): the item's shared charge pool — at most ONE charges
  // row per item (authoring-enforced). All-null recharge dice = full refill on
  // the trigger; dawn/dusk approximate to a long rest (see ItemResourcePeriod).
  maxCharges        Int?
  rechargeDiceCount Int?
  rechargeDiceFaces Int?
  rechargeBonus     Int?
  rechargeTrigger   ItemResourcePeriod?
  // Cost (in pool charges) paid by a castSpell/activatedEffect capability whose
  // resource is `charges` (null = 1). Lives on the SPENDING capability's row.
  chargeCost        Int?

  @@index([itemId])
}

// Optional 1:1 with Item, present only when category = weapon. The FK lives
// here (joins up to Item) rather than Item holding a column that points at
// this table — keeps Item itself free of per-category columns no matter how
// many detail tables exist. Dice fields are decomposed (count/faces/
// modifier) to match frontend/src/lib/dice.ts's RollSpec shape rather than
// a "1d6" string, so a future damage-roll feature reads these directly
// instead of parsing notation.
model ItemWeaponDetail {
  id     String @id @default(uuid())
  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  damageDiceCount Int
  damageDiceFaces Int
  damageModifier  Int    @default(0)
  damageType      String // e.g. "bludgeoning"

  // Versatile weapons' two-handed grip rolls a different die; null on both
  // means not versatile. Which grip is "currently" in use is deliberately
  // not persisted anywhere — a future roll UI offers both dice at roll time.
  versatileDiceCount Int?
  versatileDiceFaces Int?

  finesse     Boolean @default(false)
  light       Boolean @default(false)
  heavy       Boolean @default(false)
  twoHanded   Boolean @default(false)
  reach       Boolean @default(false)
  thrown      Boolean @default(false)
  ammunition  Boolean @default(false)
  rangeNormal Int?
  rangeLong   Int?

  // Proficiency group and melee/ranged classification — used by the
  // starting-equipment resolver to filter open picks. Nullable so existing
  // homebrew weapons and weapons added before this migration require no
  // backfill.
  weaponClass WeaponClass?
  weaponRange WeaponRange?
}

// Optional 1:1 with Item, present only when category = armor (shields
// included — a shield's baseArmorClass is its flat AC bonus rather than a
// base, same overload the 5e SRD itself uses).
model ItemArmorDetail {
  id     String @id @default(uuid())
  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  armorCategory       ArmorCategory
  baseArmorClass      Int
  dexModifierApplies  Boolean       @default(false)
  dexModifierMax      Int? // null = uncapped (light armor)
  stealthDisadvantage Boolean       @default(false)
  strengthRequirement Int?
}

// Optional 1:1 with Item, present only when category = consumable and the
// consumable actually has a roll (e.g. a potion's "2d4+2" healing) — a torch
// wouldn't have one. Same RollSpec-shaped dice fields as ItemWeaponDetail,
// for the same reason (a future "use consumable, roll its effect" feature).
model ItemConsumableDetail {
  id     String @id @default(uuid())
  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  effectDiceCount   Int?
  effectDiceFaces   Int?
  effectModifier    Int?
  effectDescription String? // e.g. "Restores hit points"

  // Limited-use charges (#121). null = stackable; non-null = charged.
  maxUses       Int?
  usesRemaining Int?
}

// Equipment packs — a named collection of items awarded as a bundle at
// character creation. The pack itself also exists as a regular catalog Item
// (category = gear) so it surfaces correctly in StartingEquipmentEditor;
// this table adds the expansion data (which items + how many).
// Seeded from the 5e Basic Rules baseline; custom packs can be added later.
model Pack {
  id          String        @id @default(uuid())
  name        String        @unique // matches the bundle catalogName, e.g. "Scholar's Pack"
  description String?
  contents    PackContent[]
}

// Join between Pack and the catalog Items it contains.
// quantity is the number of that item included in the pack.
model PackContent {
  id       String @id @default(uuid())
  packId   String
  pack     Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Int    @default(1)

  @@unique([packId, itemId])
}

// Per-character inventory row. Unlike CharacterRace/CharacterBackground
// (which carry just a drifting `name`), this snapshots the full set of
// mechanical fields from the catalog Item at add-time — see the comment on
// Character above for why. itemId is nullable: null means homebrew (no
// catalog row at all), set means "started from this catalog item," and
// either way `snapshot` is this row's own copy, free to diverge — e.g. a
// "Club +1" bumping just its own snapshot.weapon.damageModifier independent
// of the catalog Club (#1649).
model InventoryItem {
  id                    String                @id @default(uuid())
  characterId           String
  character             Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // Provenance of the source Item, catalog or DM-awarded alike (#381/#1646) —
  // SetNull so deleting the source Item leaves the awarded snapshot intact.
  itemId                String?
  item                  Item?                 @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name                  String
  category              ItemCategory
  weight                Float?
  cost                  Json?
  description           String?
  quantity              Int                   @default(1)
  // Paper-doll placement (#565). The SINGLE source of truth for "is this equipped":
  // the wire `equipped` field is DERIVED as (equippedSlot != null) in
  // serializeCharacter — there is no persisted `equipped` boolean. A two-handed
  // weapon occupies MAIN_HAND and locks OFF_HAND (never a second row).
  equippedSlot          EquipSlot?
  // Snapshot of the source Item/CampaignItem.slot for wearable gear (#565).
  slot                  EquipSlot?
  // Snapshot of the source CampaignItem.rarity for the Worn view (#565) — carried
  // alongside requiresAttunement below; display-only, no derivation reads it.
  rarity                ItemRarity?
  // Attunement state (#545) — persisted boolean; the 3-item cap is DERIVED
  // (counted), never stored. attune/unattune go through …/inventory/transactions.
  attuned               Boolean               @default(false)
  // Snapshot of the source CampaignItem's attunement metadata (#545). requiresAttunement
  // is captured at award time because the frozen copy outlives the mutable/deletable source;
  // prereqKind null = attunable by anyone (distinct from requiresAttunement false = not attunable).
  requiresAttunement    Boolean               @default(false)
  attunementPrereqKind  AttunementPrereqKind?
  attunementPrereqValue String?
  // Eldritch Knight Weapon Bond (2014, PHB'14 p.75, #1854): persisted boolean,
  // mirrors `attuned` — the WEAPON_BOND_LIMIT-item cap (lib/classes/weapon-bond.ts)
  // is DERIVED (counted), never stored. bond/unbond go through
  // POST …/abilities/weapon-bond/transactions, never PATCH. Item removal
  // self-reconciles (the flag lives ON the row, so a deleted row needs no
  // separate cleanup); a character no longer eligible (level-down, lost
  // subclass) is handled by reconcileWeaponBond (level-reconciliation.ts).
  weaponBonded          Boolean               @default(false)
  notes                 String?
  position              Int                   @default(0)
  // Uses spent on an activatedEffect capability since its last recharge (#543).
  // Reset by the matching rest; the seeded self-buff tracks the "active" state.
  activatedUsesSpent    Int                   @default(0)
  // The frozen half of this row as one document (#1648/#1649, epic #1644),
  // validated by inventorySnapshotSchema. NOT NULL: every creation path
  // (#1648) writes one, and #1649's migration asserted zero nulls before
  // dropping the four Inventory* mirror tables this replaces.
  snapshot              Json
  // Promoted out of InventoryConsumableDetail, whose maxUses twin is frozen and
  // lives in the snapshot. Mutable state stays a column: ~17 call sites update
  // it with atomic update/updateMany, and a blob would make each a
  // read-modify-write.
  //
  // NON-NULL IFF the snapshot's `consumable.maxUses` is non-null. The rest
  // sweep selects charged rows by `usesRemaining: { not: null }` and refills
  // each to its snapshot maxUses, so a row that breaks this equivalence has its
  // usesRemaining silently reset to null on the next long rest. Write the two
  // together or not at all.
  usesRemaining         Int?

  capabilityUses InventoryCapabilityUse[]
}

// The one mutable field a capability has (#1648/#1649). Keyed by the
// capability's `key` in the snapshot — an opaque string, not tied to any live
// row's id (the row it would otherwise point at, InventoryCapability, is gone).
model InventoryCapabilityUse {
  id              String        @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  capabilityKey   String
  used            Int           @default(0)

  @@unique([inventoryItemId, capabilityKey])
  @@index([inventoryItemId])
}

// ── Unified character activity log ──────────────────────────────────────────
//
// All meaningful state changes (inventory, HP, XP, currency, and future
// domains) are written here, in the same DB transaction as the state change
// itself. This is an append-only audit log — NOT event sourcing. The
// Character row stays the source of truth; these events sit beside it.
//
// Three patterns at work:
//  1. Single-Table Inheritance (category + type discriminators) — one table,
//     one ORDER BY createdAt query, no merging anywhere. Adding a new domain
//     = adding enum values, not new tables.
//  2. Polymorphic soft-reference (entityType + entityId, no FK) — points at
//     whatever row the event concerns (InventoryItem, etc.) without a hard FK
//     that breaks on deletion. Enables the per-item filter on the ledger view.
//  3. before/after JSON snapshots — "old value / new value" for field-level
//     audit; also the data needed for undo (Phase 4) without replaying
//     anything. CharacterEventField rows are derived from the diff at write time.
//
// Historical InventoryTransaction rows were migrated in on first deploy;
// the InventoryTransaction table and InventoryTxnType enum were dropped then.

enum CharacterEventCategory {
  inventory
  hitPoints
  experience
  currency
  spellcasting
  class // subclass selection and future multiclass ops
  resources // superiority dice, ki, rage, maneuvers, etc.
  advancement // ability score improvements and feats
  session // session lifecycle: started / ended
  combat // combat lifecycle: started / ended / round advanced
  conditions // status conditions (prone, poisoned, etc.) + exhaustion level
  effects // active cast-granted stat modifiers (buffs)
  roll // dice rolls logged from the session UI (attack/damage/check/save/initiative)
  // future: journal
}

enum CharacterEventType {
  // inventory (mirrors the former InventoryTxnType)
  acquired
  consumed
  sold
  bought
  removed
  // DM campaign-item award/revoke (#381)
  awarded
  revoked
  // hitPoints
  damage
  heal
  setTemp
  shortRest
  longRest
  levelUp
  levelDown
  deathSave
  stabilize
  // experience
  xpAward
  xpSet
  // currency
  currencyAdjust
  // spellcasting
  castSpell
  castAbilitySlot // row-driven {kind:"slot"} ability spend (#1687)
  expendSlot
  restoreSlot
  learnSpell
  forgetSpell
  prepareSpell
  unprepareSpell
  concentrationDropped
  convertSorceryPoints
  // class
  classAdded
  subclassChosen
  subclassRemoved
  fightingStyleChosen
  fightingStyleRemoved
  classLevelsReconciled
  // resources
  spendResource
  restoreResource
  initiativeRegen
  learnManeuver
  forgetManeuver
  maneuversReconciled
  castManeuver
  castShadowArt
  castChannelDivinity
  castStunningStrike
  imposeOpenHandRider
  setQuiveringPalm
  triggerQuiveringPalm
  dealHandOfHarm
  useHandOfUltimateMercy
  toggleElementalAttunement
  castElementalBurst
  elementalStrike
  learnToolProficiency
  forgetToolProficiency
  toolProficienciesReconciled
  // Expertise (#1588): choose/undo a skill's double proficiency bonus.
  learnExpertise
  forgetExpertise
  expertiseReconciled
  learnSubclassChoice
  forgetSubclassChoice
  subclassChoicesReconciled
  castDiscipline
  // advancement (ASI + feats)
  abilityScoreImprovement
  featTaken
  advancementRemoved
  advancementsReconciled
  // inventory (equip/unequip are logged so they appear on the timeline)
  equipped
  unequipped
  // inventory attunement (#545)
  attuned
  unattuned
  // Eldritch Knight Weapon Bond (2014, #1854)
  weaponBonded
  weaponUnbonded
  // inventory activated effects (#543)
  activated
  deactivated
  activatedRecharged
  // session lifecycle
  sessionStarted
  sessionEnded
  // combat lifecycle
  combatStarted
  combatEnded
  combatRoundAdvanced
  // combat action resolution (#1829, epic #1827) — one undoable event per
  // resolved weapon swing / spell cast, carrying its rolls in `data`
  // (replaces the separate attackRoll/damageRoll/castSpell rows a resolution
  // used to write; those event types stay for the standalone roll-log paths
  // until the adapter slices #1832/#1833 retire them).
  resolveAction
  // conditions
  conditionApplied
  conditionRemoved
  exhaustionSet
  // effects (active buffs)
  buffApplied
  buffCleared
  // roll events (rolls logged from session UI — non-undoable)
  attackRoll
  damageRoll
  checkRoll
  saveRoll
  initiativeRoll
  // meta
  revert
}

model CharacterEvent {
  id          String                 @id @default(uuid())
  characterId String
  character   Character              @relation(fields: [characterId], references: [id], onDelete: Cascade)
  category    CharacterEventCategory
  type        CharacterEventType
  // Human-readable snapshot of the action, e.g. "Leveled up to 7 (+9 HP)" or
  // "Sold Shortsword ×1 (+7 gp)". Stored so the timeline renders correctly
  // even if op semantics change in a future version.
  summary     String
  // Polymorphic soft-reference — no FK, so the event survives deletion of the
  // referenced row. entityType = "InventoryItem", entityId = the row's id.
  entityType  String?
  entityId    String?
  // Full snapshot of the affected sub-state before and after the op.
  // Null for historical rows backfilled from InventoryTransaction (no data).
  // For undo: restoring `before` reverses any event that carries it.
  before      Json?
  after       Json?
  // Op-specific inputs that aren't derivable from before/after alone, e.g.
  // method/roll/conMod for levelUp, itemName/currencyDelta for inventory.
  // Also carries undo-reconstruction data the revert handler reads but that
  // must NOT be diffed: inventory delete ops stash a self-contained
  // `data.deletedItem` snapshot here so the deleted row can be rebuilt.
  data        Json?
  // Future-proofs multi-user "who performed this action" — single-player
  // today, so always "player".
  actor       String                 @default("player")
  // Set true when this event has been compensated via a `revert` meta-event.
  // The reverted row is never deleted — history is append-only.
  reverted    Boolean                @default(false)
  batchId     String?
  // Nullable FK to the play session during which this event occurred.
  // Null for events that happen outside a session (shopping between sessions,
  // level-ups on the reference sheet, etc.).
  sessionId   String?
  session     Session?               @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())

  fields CharacterEventField[]

  @@index([characterId, createdAt])
  @@index([entityType, entityId])
  @@index([sessionId, createdAt])
}

// One shared play session per campaign sitting; participants join/leave it (#245).
// At most one `active` session per campaign, and at most one `active` solo session
// per character (campaignId null, #1080) — both enforced in lib, not a DB partial-unique.
model Session {
  id           String        @id @default(uuid())
  // Null for a character-scoped solo session (#1080).
  campaignId   String?
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status       SessionStatus @default(active)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  // Optional human-readable name for the session, e.g. "Session 4 — The Sunless Citadel".
  title        String?
  // Optional arc/part this session belongs to in the journal (#863). SetNull so
  // deleting an arc leaves the session intact and merely un-arced.
  arcId        String?
  arc          CampaignArc?  @relation(fields: [arcId], references: [id], onDelete: SetNull)
  // Campaign recap aggregate computed at session-end (#245). Null while active.
  summary      Json?
  // Combat round state (#1030) — a deliberate DERIVE-DON'T-PERSIST EXCEPTION:
  // the round is shared mutable state every participant's client must observe
  // identically, which is impossible to derive per-client. This is now the
  // authoritative read model; combatStarted/combatEnded/combatRoundAdvanced
  // CharacterEvent rows remain the audit trail, not the source of truth.
  combatActive Boolean       @default(false)
  round        Int           @default(0)
  updatedAt    DateTime      @updatedAt

  events         CharacterEvent[]
  journalEntries JournalEntry[]
  participants   SessionParticipant[]

  @@index([campaignId, status])
  @@index([arcId])
}

// One character's membership in a shared session, with their present-interval
// (joinedAt..leftAt) and per-participant summary computed at session-end (#245).
model SessionParticipant {
  id                String         @id @default(uuid())
  sessionId         String
  session           Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  characterId       String
  character         Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  joinedAt          DateTime       @default(now())
  leftAt            DateTime?
  summary           Json?
  // Per-turn spell-cast kind (#1439) — the SECOND deliberate DERIVE-DON'T-PERSIST
  // EXCEPTION, alongside Session.combatActive/round (#1030). The 5e bonus-action
  // spellcasting interlock (a leveled spell cast with your Action blocks a
  // bonus-action spell; a leveled bonus-action spell limits the Action to
  // cantrips) is a function of the TURN, not the character, so it cannot be
  // derived from any character column. It is shared state two clients viewing
  // this participant must agree on and that must survive a reload — which a
  // client-only reducer cannot provide (the reason this became server state,
  // #1439). Per-participant, not on Session: a shared field would let one PC's
  // cast wrongly block another's. Recorded when a spell resolves (resolveAction),
  // reset to null at every turn boundary (startCombat/endCombat/advanceCombatRound).
  // Null = nothing of that economy kind cast this turn. The resolved interlock
  // flags are computed from these via the one shared rule fn (spellEconomyRestrictions).
  spellCastAsAction SpellCastKind?
  spellCastAsBonus  SpellCastKind?
  // Bumped on every cast-record/reset above so the combat-state payload's
  // `updatedAt` (max of this and Session.updatedAt) advances on a
  // participant-only change, keeping the client's monotonic sync guard correct
  // for the interlock flags, not just for round (#1439).
  updatedAt         DateTime       @default(now()) @updatedAt

  @@unique([sessionId, characterId])
  @@index([sessionId])
}

// Whether the spell cast in a given economy slot this turn was a cantrip or a
// leveled spell — the raw per-turn record behind the 5e bonus-action interlock
// (#1439). Mirrors the client's SpellCastKind union.
enum SpellCastKind {
  cantrip
  leveled
}

// kind distinguishes the two capture surfaces sharing this table: full ENTRY
// rows (date/body form) vs. fast NOTE rows (one-line in-session capture, date
// defaults to today). EntryVisibility: new entries default CAMPAIGN inside a
// campaign (author can opt out to PRIVATE); campaign-less writes are PRIVATE.
// The column default stays PRIVATE so pre-#838 rows remain unshared.
enum JournalEntryKind {
  NOTE
  ENTRY
}

enum EntryVisibility {
  PRIVATE
  CAMPAIGN
}

// Freeform campaign journal — purely user-authored notes with no mechanical
// effect, so (unlike inventory/HP/XP/spellcasting) it is NOT routed through
// the audit log / transaction pattern: plain REST CRUD writes directly here.
// Optionally tagged with the session it was written during (SetNull so a
// deleted session leaves the note intact). `date` is the in-world / real date
// the player assigns to the entry; `createdAt` is the system write time used
// for stable newest-first ordering. `loggedAt` is the capture timestamp shown
// on NOTE rows. `authorUserId` denormalizes the writing user so visibleEntries
// and the backlinks visibility filter can gate by author without a join.
model JournalEntry {
  id           String           @id @default(uuid())
  characterId  String
  character    Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      Session?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  kind         JournalEntryKind @default(ENTRY)
  date         DateTime
  loggedAt     DateTime         @default(now())
  body         String
  visibility   EntryVisibility  @default(PRIVATE)
  authorUserId String
  createdAt    DateTime         @default(now())

  // Materialized @-tags pointing at CampaignEntity rows (#248).
  refs JournalEntryRef[]

  @@index([characterId, createdAt])
}

// Per-field diff rows derived from before/after at write time — the
// "field-level" layer of the "both layers" granularity choice. Each row
// records one changed leaf path (e.g. "hitPoints.max"), its old value, and
// its new value. Cascades with the parent event.
model CharacterEventField {
  id       String         @id @default(uuid())
  eventId  String
  event    CharacterEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  path     String // e.g. "hitPoints.max", "currency.gp", "quantity"
  oldValue Json?
  newValue Json?
}
