generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// level and proficiencyBonus are derived from experiencePoints at read time, never persisted columns.
//
// race/class/background are read from per-character selection rows (CharacterRace/CharacterClassEntry/CharacterBackground), not columns.
model Character {
  id        String @id @default(uuid())
  name      String
  alignment String

  // Never goes on the wire — serializeCharacter/serializeCharacterSummary derive the wire `portraitUrl` from it; mutated only by the portrait upload/delete endpoints (#1615).
  portraitKey String?

  // Ownership is identity state, not derived — exempt from derive-don't-persist. Cascade: deleting a user removes their characters.
  // assertCharacterAccess is the single ownership gate and sharing seam (#116) — never compare ownerId inline in a route.
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // SetNull: deleting a campaign leaves the character intact, just unassigned (#246).
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Read only through editionOf. Write-once: set by the create transaction, absent from PATCH and every transaction op — lets LEVEL_GATED_RECONCILERS treat edition as a constant (#1281/#1285).
  rulesEdition RulesEdition @default(EDITION_2024)

  experiencePoints Int @default(0)

  initiativeBonus Int
  speed           Int

  hitPoints     Json
  hitDice       Json
  abilityScores Json

  savingThrowProficiencies String[]
  skills                   Json
  // { name, source }[] — granted at creation by background/class/race, never trimmed on level-down. Level-gated choices live in `resources` instead.
  toolProficiencies        Json

  currency      Json
  spellcasting  Json?
  // { used: Record<key,count>, maneuversKnown: ManeuverEntry[] } — only `used`/known lists persist; totals/die-size/recharge derived by deriveResources() in src/lib/srd.ts.
  resources     Json?
  // { active: ConditionEntry[], exhaustion: number } — exhaustion is a single 0–6 level.
  conditions    Json?
  // { buffs: ActiveBuff[] } — cast-granted stat modifiers, each tagged with the casting entry id so they clear when that concentration ends. Mutate via the cast path, never PATCH.
  activeEffects Json?

  raceSelection       CharacterRace?
  backgroundSelection CharacterBackground?
  classEntries        CharacterClassEntry[]
  inventoryItems      InventoryItem[]
  events              CharacterEvent[]
  sessionParticipants SessionParticipant[]
  journalEntries      JournalEntry[]
  // Auto-created on attach to a campaign (#248).
  campaignLink        CampaignCharacterLink?
  // One row per campaign this character has ever set prefs in; the current campaign's row is surfaced on read (#537).
  campaignPreferences CampaignCharacterPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([campaignId])
}

model User {
  id          String  @id @default(uuid())
  // Nullable + unique: an emailless bootstrap user can exist (single-player today); OAuth/credential users added in #100 will carry an email.
  email       String? @unique
  name        String?
  imageUrl    String?
  // Typed JSON (#1178) so new preference keys need no migration. NULL means "never stored" (distinct from a stored object equal to the defaults) — lets first-login migration push local values up without a later device's untouched defaults clobbering real synced values.
  preferences Json?

  accounts   AuthAccount[]
  sessions   AuthSession[]
  characters Character[]

  ownedCampaigns      Campaign[]           @relation("CampaignOwner")
  campaignMemberships CampaignMembership[]

  // USER-scope catalog entries this user owns (#1796) — homebrew across every kind, not just Spell. Cascade-deleted with the user.
  catalogEntries  CatalogEntry[]
  inboxDismissals InboxDismissal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Plain-REST domain, NOT the transaction/audit pattern — membership is identity state, gated by CampaignMembership via assertCampaignMembership.
model Campaign {
  id           String       @id @default(uuid())
  name         String
  // The DM's default for characters created into this campaign (#1285). Never authoritative for an existing sheet — Character.rulesEdition is, and joining a campaign never converts it.
  rulesEdition RulesEdition @default(EDITION_2024)
  ownerId      String
  owner        User         @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  inviteCode   String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members              CampaignMembership[]
  characters           Character[]
  entities             CampaignEntity[]
  // CAMPAIGN-scoped Item rows, each auto-linked to an ITEM entity — the sole campaign-item relation.
  items                Item[]
  entityMerges         CampaignEntityMerge[]
  sessions             Session[]
  characterPreferences CampaignCharacterPreference[]
  // Campaign-level (one shared story spine), DM-curated (#863).
  arcs                 CampaignArc[]
  // Entries this campaign owns (DM homebrew, #1796); grants below surface GLOBAL/USER entries into this campaign for its players to see.
  catalogEntries       CatalogEntry[]
  catalogGrants        CatalogGrant[]
  inboxDismissals      InboxDismissal[]
}

// Campaign-level (one shared spine), DM-curated. Plain-REST CRUD, NOT the audit/transaction pattern (#863).
// `position` is an explicit ordering column the DM reorders.
model CampaignArc {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  position   Int
  createdAt  DateTime @default(now())

  sessions Session[]

  @@index([campaignId, position])
}

// Derive-don't-persist (#1945): nothing about an inbox flag itself is stored, only that a user dismissed one.
// `signature` is the flag's stable identity — a cluster whose membership changes gets a new signature and resurfaces, which is intended.
enum InboxFlagKind {
  DUPLICATE_CLUSTER
  NEEDS_CHRONICLING
}

model InboxDismissal {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind       InboxFlagKind
  signature  String
  createdAt  DateTime      @default(now())

  // campaignId is part of the identity, not just an FK — matches filterDismissed's match key, so a dismissal never silently applies across campaigns.
  @@unique([userId, campaignId, kind, signature])
}

enum CampaignRole {
  OWNER
  PLAYER
}

// 2014 = SRD 5.1, 2024 = SRD 5.2 (#1281). Both are supported editions; neither is legacy.
enum RulesEdition {
  EDITION_2014
  EDITION_2024
}

// Single member today: only a third-caster subclass (Eldritch Knight / Arcane Trickster) grants spellcasting of its own in 5e.
enum SubclassCasterFraction {
  third
}

model CampaignMembership {
  id         String       @id @default(uuid())
  campaignId String
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       CampaignRole @default(PLAYER)
  joinedAt   DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([campaignId, userId])
}

// Fully polymorphic (one `type` discriminator, no per-type FK columns) — a new entity kind is an enum value, not a table (#248).
// Notes @-tag an entity via an @[<uuid>] token in the body; JournalEntryRef materializes each tag as a backlink.
// A PC entity is auto-created + linked when a character attaches to the campaign (CampaignCharacterLink).
enum EntityType {
  NPC
  LOCATION
  FACTION
  ITEM
  PC
  OTHER
}

// HIDDEN entities are invisible to non-owner members; the owner always sees all. Default REVEALED (#379).
enum EntityVisibility {
  HIDDEN
  REVEALED
}

model CampaignEntity {
  id          String           @id @default(uuid())
  campaignId  String
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type        EntityType
  name        String
  aliases     String[]         @default([])
  notes       String?
  // Never goes on the wire — toWireEntity derives the wire portraitUrl from it; mutated only by the entity portrait upload/delete endpoints (#1617).
  portraitKey String?
  visibility  EntityVisibility @default(REVEALED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  refs          JournalEntryRef[]
  characterLink CampaignCharacterLink?
  // The item this entity fronts (#380).
  itemLink      CampaignItemLink?
  // The (single) merge where this entity is the old identity, and the merges where it is the surviving true identity (#387).
  mergedInto    CampaignEntityMerge?   @relation("MergedIdentity")
  survivorOf    CampaignEntityMerge[]  @relation("SurvivorIdentity")

  @@index([campaignId, type])
}

// One row per (entry, entity) tag, derived from the @[<uuid>] tokens in the entry body on journal write; cascades from both sides.
model JournalEntryRef {
  id       String         @id @default(uuid())
  entryId  String
  entry    JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entityId String
  entity   CampaignEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entryId, entityId])
  @@index([entityId])
}

// Links a character to its auto-created PC entity (1:1 both ways).
model CampaignCharacterLink {
  id               String         @id @default(uuid())
  campaignEntityId String         @unique
  campaignEntity   CampaignEntity @relation(fields: [campaignEntityId], references: [id], onDelete: Cascade)
  characterId      String         @unique
  character        Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// Non-destructive "revealed to be" link — neither row is destroyed and no journal ref is rewritten (#387).
// PREPARED = DM's secret prep (scrubbed from non-owner payloads); EXECUTED = the public reveal.
// Chains resolve transitively; cascades from either entity.
enum MergeStatus {
  PREPARED
  EXECUTED
}

model CampaignEntityMerge {
  id               String         @id @default(uuid())
  campaignId       String
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // At most one merge per merged entity.
  mergedEntityId   String         @unique
  mergedEntity     CampaignEntity @relation("MergedIdentity", fields: [mergedEntityId], references: [id], onDelete: Cascade)
  // May itself be merged further up the chain.
  survivorEntityId String
  survivorEntity   CampaignEntity @relation("SurvivorIdentity", fields: [survivorEntityId], references: [id], onDelete: Cascade)
  status           MergeStatus    @default(PREPARED)
  note             String?
  preparedAt       DateTime       @default(now())
  executedAt       DateTime?

  @@index([campaignId])
  @@index([survivorEntityId])
}

// 1:1 both ways, same pattern as CampaignCharacterLink. Deleting the item deletes both this link (cascade) and the fronting entity in the same transaction — the entity has no life without its item.
model CampaignItemLink {
  id               String         @id @default(uuid())
  campaignEntityId String         @unique
  campaignEntity   CampaignEntity @relation(fields: [campaignEntityId], references: [id], onDelete: Cascade)
  itemId           String         @unique
  item             Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// Scoped to (campaign, character) so the same character can carry different settings across campaigns (#537). Both FKs cascade.
model CampaignCharacterPreference {
  id          String    @id @default(uuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  shareWithDm         Boolean @default(false)
  autoFriendlyHealing Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, characterId])
  @@index([characterId])
}

// Tokens live here, never on User — a user can hold several providers and rotating tokens never touches the identity row.
model AuthAccount {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  // Null for OAuth; set only for future local username/password credentials.
  passwordHash      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

// `id` is the opaque cookie token itself (no default) — generated by the auth layer and stored verbatim, so a leaked token can't be guessed from a sequential/uuid pattern we control here.
model AuthSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Baseline lists offered in the character-creation form, NOT referenced directly by Character — only through the nullable FKs on the selection models below, so deleting/renaming a catalog row never breaks an existing character sheet.

// `edition` is NOT NULL — no species is edition-neutral (a 2014 and 2024 Dwarf are two rows sharing a name, never one shared row).
// SpeciesVariant/SpeciesTrait/SpeciesGrantedSpell carry no `edition` column of their own — they inherit it through speciesId.
model Species {
  id               String       @id @default(uuid())
  name             String
  slug             String
  speed            Int
  edition          RulesEdition
  // AbilityIncreaseSpec[] (fixed | choose | floating), validated seed-time by abilityIncreasesSchema and cast unchecked by resolveSpeciesGrants.
  // [] for every EDITION_2024 row — 2024 ability increases come from backgrounds only, never species (PHB'24 p.38).
  // Applied result snapshots onto CharacterRace.abilityBonuses.
  abilityIncreases Json         @default("[]")

  variants      SpeciesVariant[]
  traits        SpeciesTrait[]
  grantedSpells SpeciesGrantedSpell[]
  selections    CharacterRace[]

  @@unique([name, edition])
  @@unique([slug, edition])
}

// A species' second creation step (2014 subrace / 2024 lineage/legacy/ancestry); Draconic Ancestry also lives here in both editions. No `edition` column — inherits the parent Species row's.
model SpeciesVariant {
  id                      String  @id @default(uuid())
  speciesId               String
  species                 Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  name                    String
  slug                    String
  // NULL = use the parent Species.speed.
  speedOverride           Int?
  // Same shape as Species.abilityIncreases; additive to the parent's at creation. [] for every 2024 row and every Dragonborn ancestry variant (draconic ancestry grants a damage type + resistance, not an ability increase).
  abilityIncreases        Json    @default("[]")
  // True replaces the parent Species' abilityIncreases instead of adding (fetchMergedAbilityIncreases); only Astral Elf sets this. Default false keeps every other subrace additive.
  abilityIncreasesReplace Boolean @default(false)

  traits        SpeciesTrait[]
  grantedSpells SpeciesGrantedSpell[]
  selections    CharacterRace[]

  @@unique([speciesId, name])
  @@unique([speciesId, slug])
}

// variantId is NULL for a species-level trait, set for a variant-only one — same base-required/child-optional shape as ClassFeature's classId/subclassId.
model SpeciesTrait {
  id           String          @id @default(uuid())
  speciesId    String
  species      Species         @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      SpeciesVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name         String
  description  String
  // FeatImprovement[] — same vocabulary as Feat.improvements, reused verbatim.
  improvements Json            @default("[]")
  // speciesTraitChoiceSchema (lib/srd/species-trait-choices.ts) — the player-CHOICE vocabulary a fixed FeatImprovement can't express ("choose two skills"). NULL for announce-only/fixed traits; set only on the trait row that carries the choice. A single object, not an array like `improvements` — one trait row is always exactly one mechanic.
  choice       Json?

  // Postgres does not auto-index FK columns; both are queried directly (by species, by variant).
  @@index([speciesId])
  @@index([variantId])
}

// No `edition` column — inherits edition through speciesId (unlike SubclassGrantedSpell's nullable edition).
model SpeciesGrantedSpell {
  id        String          @id @default(uuid())
  speciesId String
  species   Species         @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  variantId String?
  variant   SpeciesVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  spellId   String
  spell     Spell           @relation(fields: [spellId], references: [id], onDelete: Cascade)
  gateLevel Int

  @@index([speciesId])
}

model CharacterClass {
  id                String   @id @default(uuid())
  name              String   @unique
  hitDie            String
  savingThrows      String[]
  skillChoiceCount  Int
  skillChoices      String[]
  isSpellcaster     Boolean  @default(false)
  // 2014 level this class first grants a subclass choice (PHB'14). SRD 5.2 ignores this column — subclassGateLevel hardcodes 3 for every class under EDITION_2024 (#1308).
  subclassLevel     Int      @default(3)
  toolProficiencies String[] @default([])
  toolChoices       String[] @default([])
  toolChoiceCount   Int      @default(0)

  // SRD 5.1/PHB'14 values only — at least Bard/Druid/Monk/Rogue/Sorcerer/Wizard differ under SRD 5.2/PHB'24; when 2024 lists are authored, fork via one rule function taking `edition`, never a second column or `=== "EDITION_…"`.
  armorProficiencies      String[] @default([])
  weaponProficiencies     String[] @default([])
  // Levels beyond the edition-invariant base schedule (4/8/12/16/19, BASE_ASI_LEVELS) — Fighter [6,14], Rogue [10]. ASI levels agree across editions, so no edition fork.
  extraAsiLevels          Int[]    @default([])
  // Level this class grants a Fighting Style feat pick (Fighter 1, Paladin/Ranger 2 — agrees across editions); NULL = never. What differs by edition is feat-vs-menu (SRD 5.2 p. 47), not this level.
  fightingStyleFeatLevel  Int?
  // PHB'14 p. 163: array of AND-option-groups, OR'd together — e.g. Fighter [{strength:13},{dexterity:13}] (the only OR class). Json, not String[], to express the OR-of-AND shape. Edition-invariant.
  multiclassPrerequisites Json     @default("[]")
  // PHB'24 "Primary Ability" column. PHB'14 has no equivalent (Quick Build suggestions instead) — 2024-sourced only, not edition-invariant.
  primaryAbilities        String[] @default([])

  entries                   CharacterClassEntry[]
  subclasses                Subclass[]
  // Back-relation only — not a column, appears on no payload unless included.
  features                  ClassFeature[]
  // Back-relation only — not a column, appears on no payload unless included.
  startingEquipmentPackages StartingEquipmentPackage[]
}

// SetNull — deleting a catalog subclass leaves existing CharacterClassEntry rows intact.
// Homebrew = null subclassId with a drifting name string, same pattern as races/classes/backgrounds.
model Subclass {
  id                  String                  @id @default(uuid())
  classId             String
  class               CharacterClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  name                String
  description         String
  // Stable mechanics identity — the join key to the lib/classes/*.ts definition (#1277). Immutable: a display-name rename must not change it. Vocabulary is SUBCLASS_SLUGS; resolveSubclassSlug is the one place a character resolves onto it.
  slug                String
  // NULL = valid in both editions; a diverging subclass forks into one row per edition sharing this name. NULLS NOT DISTINCT on the migration's unique index — see resolveEditionRow.
  edition             RulesEdition?
  // NULL for every non-caster subclass; "third" for Eldritch Knight / Arcane Trickster today. thirdCasterAbilityOf's `!== "third"` gate must fail to compile on an unrecognized value — extend the enum, never add a second column.
  casterFraction      SubclassCasterFraction?
  // NULL alongside casterFraction for a non-caster subclass. Plain string, not an enum like casterFraction — no call site branches on it the way thirdCasterAbilityOf does, so there's no compile-time gate to buy.
  spellcastingAbility String?

  selections          CharacterClassEntry[]
  grantedSpells       SubclassGrantedSpell[]
  // Back-relation only — not a column, appears on no payload unless included.
  features            ClassFeature[]
  // Back-relation only, same role as grantedSpells — the choosable-pool widening a picker resolves, not a sheet-facing payload field.
  spellListExpansions SubclassSpellListExpansion[]

  // Name stays "classId_name" (not classId_name_edition): a rename silently breaks every findUnique compound-key literal at runtime.
  @@unique([classId, name, edition], name: "classId_name")
  // Slug-form twin of classId_name — a lineage that forks across editions keeps one slug and two rows. NULLS NOT DISTINCT lives in the migration (Prisma's DSL can't express it).
  @@unique([slug, edition], name: "slug_edition")
}

// Keyed to the shared Spell catalog by FK — the subclass's spell content lives once, in the catalog, referenced here rather than snapshotted (#898). Resolved live in deriveGrantedSpells; never persisted onto the character.
model SubclassGrantedSpell {
  id             String        @id @default(uuid())
  subclassId     String
  subclass       Subclass      @relation(fields: [subclassId], references: [id], onDelete: Cascade)
  spellId        String
  spell          Spell         @relation(fields: [spellId], references: [id], onDelete: Cascade)
  // No default: real grants span levels 1–17 (Cleric 1/3/5/7/9, Paladin 3/5/9/13/17), so every seed/write sets it explicitly.
  gateLevel      Int
  castingAbility String
  // NULL = granted in both editions; a list that diverges forks into one row per edition. A granted-spell list is a SET, so the read path is a set filter in deriveGrantedSpells (edition-or-NULL admission), not resolveEditionRow's pick-one fallback. A (subclass, spell, NULL) row alongside a tagged twin is forbidden at authoring time by seed-data.test.ts's shared-XOR-forked guard. NULLS NOT DISTINCT lives in the migration (Prisma's DSL can't express it).
  edition        RulesEdition?

  @@unique([subclassId, spellId, edition])
  @@index([subclassId])
}

// Sibling of SubclassGrantedSpell but categorically distinct: not a free grant, it widens what a known caster may PICK, still spending an ordinary spells-known slot (#1631). Carries no gateLevel or castingAbility — both deliberate omissions vs. SubclassGrantedSpell. Resolved live by the creation/level-up spell pickers, unioned into the choosable pool; never persisted onto the character.
model SubclassSpellListExpansion {
  id         String        @id @default(uuid())
  subclassId String
  subclass   Subclass      @relation(fields: [subclassId], references: [id], onDelete: Cascade)
  spellId    String
  spell      Spell         @relation(fields: [spellId], references: [id], onDelete: Cascade)
  // NULL = valid in both editions; same NULL-as-shared convention as SubclassGrantedSpell.edition, and same set-filter (not pick-one) read path.
  edition    RulesEdition?

  @@unique([subclassId, spellId, edition])
  @@index([subclassId])
}

// Real relations, not bare scalar FKs: the read path arrives through the include that already loads class/subclass, and the derivation path must stay synchronous. subclassId is NULL for a base-class feature (the majority).
model ClassFeature {
  id          String         @id @default(uuid())
  classId     String
  class       CharacterClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subclassId  String?
  subclass    Subclass?      @relation(fields: [subclassId], references: [id], onDelete: Cascade)
  name        String
  level       Int // absolute character level, not a subclass-relative grant level
  description String

  // Non-nullable, unlike every other catalog `edition RulesEdition?` — every ClassFeature row forks, so resolveEditionRow's shared-row fallback is unreachable by type.
  edition RulesEdition

  resourceKey           String?
  resourceLabel         String?
  resourceRecharge      String? // RechargeOn
  resourceTotals        Json? // [{ minLevel, total }] — total: number | "proficiencyBonus" | { abilityMod, plus?, min? } | { levelTimes } — ASCENDING by minLevel, last-match-wins
  resourceDieTiers      Json? // [{ minLevel, die }] — ASCENDING by minLevel, last-match-wins
  resourceRechargeTiers Json? // [{ minLevel, recharge }] — recharge: RechargeOn — ASCENDING by minLevel, last-match-wins
  resourceDetailTiers   Json? // [{ minLevel, label, value }] — labeled display parts (DerivedResource.details) — ASCENDING by minLevel PER LABEL, last-match-wins per label; different labels interleave freely
  resourceOnInitiative  Json? // InitiativeRegenRow[] — regain-on-rolling-Initiative descriptors — minLevel gates each entry ADDITIVELY, unlike the tier columns above's last-match-wins

  // Choice block — the row-driven counterpart to SubclassDefinition.choices.
  choiceKey           String? // ResourcesMutableState.choicesKnown map key
  choiceLabel         String? // display label; absent = the row's name
  choiceCatalogSource String? // GrantedAbility.source of the option catalog
  choiceCountTiers    Json? // [{ minLevel, count }] — ASCENDING by minLevel, last-match-wins

  // Activation block — gated by the row itself (classId/subclassId/level), never separate grant columns.
  activationCost     String? // ActionCost: action | bonusAction | reaction | free | special
  resolverKind       String? // ResolutionKind — served on the wire, retiring the frontend mirror
  requiresUnarmored  Boolean  @default(false)
  regrants           String[] @default([])
  // Declarative activation-time gates (#1688): armor/shield literals ("noMediumArmor" | "noHeavyArmor" | "noShield" | "noBodyArmor") or `{ requiresActiveBuff: <buffKey> }`, evaluated by unmetActivationRequirements. Validated seed-time (classFeatureSeedSchema).
  activationRequires Json?
  // In-play announce text, distinct from `description` — buildRowAction serves it only when describeRowReminder yields nothing.
  reminder           String?
  // A resolved numeric fact rendered verbatim — a level-gated bump is an announce-augmentor payload, never a second row.
  count              Int?
  // No feature-card text — featuresFromRows filters it out of every DerivedFeature projection; surfaces only in `availableActions[]`. Requires activationCost + resourceKey (seed-enforced) or it's dead data.
  actionOnly         Boolean  @default(false)

  // Cost block — GrantedAbility's columns verbatim (AbilityCostColumns) so readAbilityCost reads them unchanged.
  costKind    String?
  costPoolKey String?
  costBase    Int?
  costPerStep Int?

  // Effect block — GrantedAbility's columns MINUS upcastDicePerLevel/cantripScaling/concentration: resolveEffectScaling reads EffectRow.level as the SPELL level, while this model's `level` is the character level — never add those three columns back. Readers adapt via castSpecFromRow's `{ ...row, level: 0 }`.
  effectKind           String?
  effectDiceCount      Int?
  effectDiceFaces      Int?
  effectDieSource      String?
  effectModifier       Int?
  effectModifierSource String? // "classLevel" | "abilityMod:<ability>"
  damageType           String?
  attackType           String?
  saveAbility          String?
  saveEffect           String?
  buffTarget           String?
  buffModifier         Int?

  // Permanent, level-gated derived-stat modifier (Extra Attack, crit range) — not a duration-bound buff.
  derivedStat      String?
  derivedStatTiers Json? // [{ minLevel, value }] — ASCENDING by minLevel, last-match-wins

  // Closed-form save DC: 8 + proficiency + the higher named ability (PHB'14 p.73 / PHB'24 p.83). A non-empty list IS the trigger — never matched by derivedStat name. Feeds ClassExtras.announcedSaveDC; a second class entry also declaring one is a logged-and-dropped collision, not a crash (assignAnnouncedSaveDC keeps the primary entry's DC — throwing here would 500 the character load) — why Cleric keeps its own channelDivinitySaveDC path instead of using this column.
  saveDcAbilities String[] @default([])

  // A passive grant no other column expresses. Validated against featImprovementSchema — the same vocabulary a taken feat's `improvements` snapshot uses, reused not forked.
  improvements Json?

  // While-active buffs a "toggle" resolverKind activates (#1686): [{ key, target, modifier, duration, minLevel?, clearOn?, endReminder?, resistDamageTypes?, rollEffects? }] — evaluateBuffModifier interprets `modifier` (a ResourceTotalFormula or ASCENDING tier array); `target` may equal the buff's own `key` (a marker buff); `clearOn` lists CLEAR_ON_TRIGGERS keys matched by equipClearTriggers.
  effectBuffs Json?

  // Plain String[] rather than nested in effectBuffs — an unconditional immunity (Beguiling Defenses, Nature's Ward) would otherwise need a fake always-active buff.
  conditionImmunities                  String[] @default([])
  // Gates the immunities on a buff of this key being active (e.g. Mindless Rage names "rage"); null = unconditional.
  conditionImmunitiesRequireActiveBuff String?
  // For an existing matching condition when the gating buff STARTS: "clear" removes it permanently (2024 Mindless Rage, SRD 5.2); "suspend" restores it when the buff ends (2014 Mindless Rage, PHB'14 p.49). Interpreted by syncConditionImmunityOnBuffStartInTx (lib/combat/conditions.ts) and conditionImmunitiesFromRows.
  conditionImmunitiesOnBuffStart       String?

  // NULLS NOT DISTINCT is hand-written in the migration (Prisma's DSL cannot express it): subclassId is nullable, so without it two identical base-class rows would both insert.
  @@unique([classId, subclassId, name, edition])
  // The read path joins on subclassId alone; the classId-prefixed compound unique above cannot serve it.
  @@index([subclassId])
}

// `edition` is NON-NULLABLE: there is no edition-neutral starting package — a nullable column here is exactly how a 2014 package could silently serve a 2024 character.
// Exactly one of classId/backgroundId is set per row, enforced by a hand-written CHECK constraint (Prisma's DSL has no `@@check`).
model StartingEquipmentPackage {
  id           String          @id @default(uuid())
  classId      String?
  class        CharacterClass? @relation(fields: [classId], references: [id], onDelete: Cascade)
  backgroundId String?
  background   Background?     @relation(fields: [backgroundId], references: [id], onDelete: Cascade)
  // Mirror of CharacterClass.name / Background.name (whichever FK is set) — carried only so staleCatalogRowsWhere/startingEquipmentStaleWhere can partition this family's prune by (identity, edition). Every lookup goes through classId/backgroundId; nothing may key on this column.
  name         String
  edition      RulesEdition

  // NULL = PHB'24 (and every background) has no roll-for-gold rule, distinct from 0/0/0 ("roll zero gold"). Jointly null, never partial — enforced by a hand-written CHECK constraint (Prisma's DSL has no `@@check`).
  // resolveStartingGold rejects rather than computing when handed a NULL-dice package — those reach gold through StartingEquipmentOption.gold instead.
  goldDiceCount  Int?
  goldDiceFaces  Int?
  goldMultiplier Int?

  groups StartingEquipmentGroup[]

  @@unique([classId, edition])
  @@unique([backgroundId, edition])
}

model StartingEquipmentGroup {
  id        String                   @id @default(uuid())
  packageId String
  package   StartingEquipmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  // Load-bearing, not cosmetic: the creation client indexes options positionally (collectGroupRefs), and rows come back in arbitrary order without an explicit orderBy — assigned by array index at seed time so it's deterministic by construction.
  position  Int
  label     String

  options StartingEquipmentOption[]

  @@unique([packageId, position])
}

model StartingEquipmentOption {
  id       String                 @id @default(uuid())
  groupId  String
  group    StartingEquipmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  position Int
  label    String
  // GP this option grants on top of (or instead of) its items. Every EDITION_2014 option is 0 — 2014's gold is the package-level dice roll (StartingEquipmentPackage.goldDiceCount/Faces/Multiplier) instead.
  gold     Int                    @default(0)

  items     StartingEquipmentItem[]
  openPicks StartingEquipmentOpenPick[]

  @@unique([groupId, position])
}

model StartingEquipmentItem {
  id          String                  @id @default(uuid())
  optionId    String
  option      StartingEquipmentOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  position    Int
  // NAME reference, deliberately not a FK to Item: resolveFixedItems looks a ref up against Pack first and falls through to Item, so an Item FK would make "Dungeoneer's Pack" unexpressible. The seed validator checks ITEMS ∪ PACKS instead (assertSeedContentValid).
  catalogName String
  quantity    Int                     @default(1)

  @@unique([optionId, position])
}

model StartingEquipmentOpenPick {
  id                String                  @id @default(uuid())
  optionId          String
  option            StartingEquipmentOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  position          Int
  label             String
  // Named after ItemWeaponDetail's columns, which openPickFilterError compares against — NOT after the wire field. mapStartingEquipmentPackage's mapOpenPick is the mapper that renames `weaponRange` to the wire's `range`. If you rename either side, rename the mapper in the same diff.
  weaponClass       WeaponClass? // null = any
  weaponRange       WeaponRange? // null = any
  // Mirrors Item.toolCategory, which openPickFilterError compares against.
  toolCategory      ToolCategory? // null = not tool-filtered
  // True when this pick must match ONE OF the character's own creation tool choices (creationToolProfs) rather than being a free choice — Monk's "Artisan's Tools or Musical Instrument chosen for the tool proficiency above" would otherwise let a Monk take an instrument with no proficiency in it.
  boundToToolChoice Boolean                 @default(false)
  quantity          Int                     @default(1)

  @@unique([optionId, position])
}

model Background {
  id                 String        @id @default(uuid())
  name               String
  skillProficiencies String[]
  toolProficiencies  String[]      @default([])
  // Mirrors CharacterClass.toolChoices/toolChoiceCount exactly — a background can grant a tool choice as well as a fixed tool. Edition-invariant columns; only the seeded content per row differs.
  toolChoices        String[]      @default([])
  toolChoiceCount    Int           @default(0)
  // PHB'24: each background grants +3 ability points across these three abilities (2+1 or 1+1+1) plus one Origin feat. Empty/null for spec-less 2014 legacy rows.
  abilityChoices     String[]      @default([])
  originFeatId       String?
  originFeat         Feat?         @relation(fields: [originFeatId], references: [id], onDelete: SetNull)
  // NULL = valid in both editions; only a genuinely diverging background forks into one row per edition sharing this name. NULLS NOT DISTINCT on the migration's unique index — see resolveEditionRow.
  edition            RulesEdition?

  selections                CharacterBackground[]
  // Back-relation only — not a column, appears on no payload unless included.
  startingEquipmentPackages StartingEquipmentPackage[]

  @@unique([name, edition])
}

// Each selection links a Character to a catalog row (optionally — null means homebrew, no baseline) and carries its own `name`, defaulting to the catalog entry's name at creation but free to drift independently.

model CharacterRace {
  id                    String          @id @default(uuid())
  characterId           String          @unique
  character             Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name                  String
  // The mechanical anchor (#1679, epic #1518); nullable for the same reason CharacterBackground.backgroundId is — a homebrew/fixture row with no catalog anchor is still a legal CharacterRace. variantId is set only for a variant-bearing species.
  speciesId             String?
  species               Species?        @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  variantId             String?
  variant               SpeciesVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // NULL when no variant was chosen (variantless species or a homebrew/fixture row with no speciesId).
  variantName           String?
  // Provenance snapshot of the ability increases actually applied, written by resolveSpeciesGrants — [] for a 2024 character or a species with no increases in its merged spec. Species is immutable post-creation (no transaction endpoint, absent from PATCH), so no LEVEL_GATED_RECONCILERS entry follows: this state's legal maximum is fixed at creation, never revisited by level.
  abilityBonuses        Json            @default("[]")
  // The Int/Wis/Cha casting-ability choice a 2024 lineage/legacy makes when gained, snapshotted here rather than on SpeciesGrantedSpell because the row is shared catalog content and the choice is per-character. NULL for a 2014 character, a species/variant with no spell grant, or before the picker runs. Immutable post-creation, same reasoning as abilityBonuses.
  castingAbility        String?
  // Provenance snapshot of species-granted creation choices applied — audit-only; the functional grant lives elsewhere (speciesSkills fold into skillProficiencies; the cantrip lands in Character.spellcasting.spells). [] / null for a species with no choice-bearing trait.
  speciesSkills         String[]        @default([])
  speciesCantripName    String?
  // Provenance snapshot of a species-granted Origin feat pick (audit-only). The functional grant lives on Character.resources.advancements as a slot-exempt AdvancementEntry, never re-derived from this column. NULL for every species with no chooseOriginFeat trait.
  speciesOriginFeatName String?
}

model CharacterBackground {
  id           String      @id @default(uuid())
  characterId  String      @unique
  character    Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  backgroundId String?
  background   Background? @relation(fields: [backgroundId], references: [id], onDelete: SetNull)
  name         String
}

// One-to-many (not @unique on characterId): a character can hold several class entries, which is what multiclassing needs. v1 always creates exactly one entry per character (position 0).
model CharacterClassEntry {
  id          String          @id @default(uuid())
  characterId String
  character   Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  classId     String?
  class       CharacterClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  name        String
  level       Int             @default(1)
  // Null = no subclass chosen yet.
  subclass    String?
  subclassId  String?
  subclassRef Subclass?       @relation(fields: [subclassId], references: [id], onDelete: SetNull)
  position    Int             @default(0)
}

enum ItemCategory {
  weapon
  armor
  consumable
  gear
}

// GLOBAL rows are seeded catalog content with exactly one writer; CAMPAIGN rows are DM-authored. Adding USER needs no redesign (see Item.scopeKey) but is NOT free: Item_scope_key_agreement_check enumerates the scopes, so a new member without a matching CHECK branch rejects every insert.
enum ItemScope {
  GLOBAL
  CAMPAIGN
}

// The six 5e magic-item rarity tiers (DMG p. 135). Rules data + gp values live in lib/srd.ts (ITEM_RARITIES); this is only the persisted column domain.
enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  VERY_RARE
  LEGENDARY
  ARTIFACT
}

enum ArmorCategory {
  light
  medium
  heavy
  shield
}

// A worn/wielded item occupies exactly one slot per row; RING has capacity 2, every other slot capacity 1. A two-handed weapon sits in MAIN_HAND and locks OFF_HAND (never a second row). Gear declares its slot via the nullable Item.slot / InventoryItem.slot column (null = bag-only, not wearable).
enum EquipSlot {
  MAIN_HAND
  OFF_HAND
  BODY
  HEAD
  NECK
  CLOAK
  HANDS
  WRISTS
  BELT
  FEET
  RING
}

// Used by the starting-equipment package resolver to filter open picks like "any martial weapon". Nullable: homebrew weapons may omit classification without breaking anything.
enum WeaponClass {
  simple
  martial
}

// Combined with WeaponClass for finer open-pick filters like "any martial melee weapon". Nullable for the same reason as WeaponClass.
enum WeaponRange {
  melee
  ranged
}

// SRD 5.1 / SRD 5.2 — both editions' tools pages list all three categories. Only the items that are actual tools carry this on Item; most of TOOLS has no Item row at all.
enum ToolCategory {
  artisan
  gamingSet
  musicalInstrument
  other
}

enum SessionStatus {
  active
  ended
}

// Reserves the full A–E menu; only passiveBonus is implemented this slice — the rest are forward-declared so the side-table column set + adapter don't churn when they land.
enum CapabilityKind {
  passiveBonus
  castSpell
  charges
  grant
  activatedEffect
}

// atWill is unlimited (no use tracking). perDay dawn/dusk approximate to a long rest. charges spends the item's shared charge pool (chargeCost per cast) instead of a per-capability counter.
enum CapabilityCastResource {
  perRestShort
  perRestLong
  perDayDawn
  perDayDusk
  atWill
  charges
}

// Whether a castSpell DC / attack bonus is a fixed item value or resolves to the wielder's own spell save DC / spell attack.
enum CapabilityCastStatMode {
  fixed
  wielder
}

// Only scalar targets are summed into the modifier channel today.
enum CapabilityTarget {
  ac
  attack
  damage
  save
  skill
  abilityScore
  spellAttack
  spellDc
  initiative
  speed
  maxHp
}

// setTo (absolute floor/override) is not yet consumed in derivation this slice.
enum CapabilityOp {
  add
  setTo
}

// commandWord is a no-action verbal toggle; the rest mirror 5e's action economy.
enum ActivationType {
  action
  bonus
  reaction
  commandWord
}

// Maps to the ActiveBuff duration axis: whileActive = manual toggle-off, untilRest = a rest.
enum ActivatedDuration {
  whileActive
  untilRest
}

// perRest/perDay bound the uses per period; atWill is unlimited (never spends). charges spends the item's shared charge pool (chargeCost per activation).
enum ItemResourceKind {
  perRest
  perDay
  atWill
  charges
}

// short|long pair with perRest; dawn|dusk with perDay (approximated to a long rest on reset).
enum ItemResourcePeriod {
  short
  long
  dawn
  dusk
}

// value carries the specific class/species/alignment; spellcaster needs no value.
enum AttunementPrereqKind {
  class
  spellcaster
  species
  alignment
}

// Mirrors frontend/src/types/character.ts SpellSchool — the two must stay in sync.
enum SpellSchool {
  abjuration
  conjuration
  divination
  enchantment
  evocation
  illusion
  necromancy
  transmutation
}

// Serves universal actions (available to every character) to GET /api/reference;
// `key` also doubles as the dispatch identity ACTION_EFFECT_FN is keyed by for the
// actions/transactions endpoint. Every row is `universal: true` — class/subclass/
// level gating for class-specific actions lives elsewhere: the one permanent
// DERIVED_ACTIONS holdout (summonBondedWeapon), or a ClassFeature row's own
// activationCost/resourceKey columns, post-#1522 retab (#1979). Adding a
// universal action: append a row here and an ACTION_EFFECT_FN entry (or
// NO_DISPATCH_ACTION_KEYS if it's reminder-only) — the seed-side
// ACTION_EFFECT_FN parity test enforces the two stay in sync. No migration
// needed for a new row; only a new column needs one.
model Action {
  id          String @id @default(uuid())
  key         String // stable machine key, e.g. "rage" | "dodge"
  name        String // display label
  description String

  // Which economy slot this action consumes on the character's turn.
  cost ActionCost

  // Always true today (see the model comment above) — kept as a real column, not a hardcoded assumption, so a future non-universal use has somewhere to land without a migration.
  universal Boolean @default(false)

  // NULL = valid in both editions (#1306); no seeded row uses it today since every universal row forks per edition — each `description` is a transcription from ONE named document, so a shared row could only cite "SRD 5.1 and SRD 5.2" and an ambiguous citation is a bug. The business key is (key, edition) rather than plain `key` — `key` is edition-stable identity, so the 2024 Magic row keeps `key: "castSpell"`.
  edition RulesEdition?

  // NULLS NOT DISTINCT is hand-written in the migration (Prisma's DSL cannot emit it), so a shared (NULL-edition) row still admits at most one row per key.
  @@unique([key, edition])
}

enum ActionCost {
  action
  bonusAction
  reaction
  free
  special
}

// source discriminates ("maneuver" for Battle Master, "shadowArts" for Way of Shadow, "channelDivinity", plus subclass choose-N option sources). Provenance pointer in ManeuverEntry.maneuverId.
model GrantedAbility {
  id          String  @id @default(uuid())
  name        String
  source      String  @default("maneuver")
  description String
  minLevel    Int     @default(3) // minimum level to learn/use
  alwaysKnown Boolean @default(false) // always known (bypasses the choice cap)

  // Battle Master maneuver placement/action metadata (source "maneuver" only). placement routes the session UI: attackRoll | damageRoll | reaction | effect | attackOption. actionSlot is the economy slot consumed, null when none. selfTempHp = Rally.
  placement  String?
  actionSlot String?
  selfTempHp Boolean @default(false)

  // Embedded AbilityCost — focus/superiority-die pool spend, or a spell-slot spend. kind "none" = free.
  costKind    String? // "none" | "pool" | "slot"
  costPoolKey String? // e.g. "focus" — "pool" only
  costBase    Int? // "pool": base pool cost. "slot": minimum slot level (AbilityCost's minLevel) — reused rather than a dedicated column since a row is never both kinds at once.
  costPerStep Int? // additional units per scaling step — "pool" only

  // Embedded EffectSpec — same flat columns as Spell. saveAbility doubles as the ability's DC save ability.
  effectKind         String?
  effectDiceCount    Int?
  effectDiceFaces    Int?
  effectDieSource    String? // e.g. "superiorityDice" — resolves faces from DerivedClassInfo, supersedes effectDiceFaces
  effectModifier     Int?
  damageType         String?
  attackType         String?
  saveAbility        String?
  saveEffect         String?
  upcastDicePerLevel Int?
  cantripScaling     Boolean @default(false)

  // Applies a flat modifier to a skill/stat target while the granting concentration holds. null = not a buff.
  buffTarget   String?
  buffModifier Int?

  // Same shape/evaluator as ClassFeature.effectBuffs. No maneuver/GrantedAbility row populates this yet.
  effectBuffs Json?

  // Same vocabulary/evaluator as ClassFeature.activationRequires. No maneuver row populates this yet.
  activationRequires Json?

  // NULL = valid in both editions; a diverging maneuver / shadow art / channel divinity / subclass-choice option forks into one row per edition sharing this name. NULLS NOT DISTINCT on the migration's unique index — see resolveEditionRow.
  edition RulesEdition?

  // `source` is deliberately NOT in the key: a name identifies exactly one row across maneuver/shadowArts/channelDivinity/choice sources, and every name-keyed lookup relies on that.
  @@unique([name, edition])
}

// PHB'24 feat categories: Origin (background-granted, no level req), General (level 4+, +1 ability), Fighting Style, and Epic Boon (level 19+).
enum FeatCategory {
  origin
  general
  fighting_style
  epic_boon
}

model Feat {
  id                String        @id @default(uuid())
  name              String
  description       String
  prerequisite      String?
  category          FeatCategory  @default(general)
  levelPrerequisite Int? // General ⇒ 4, Epic Boon ⇒ 19 (PHB'24)
  repeatable        Boolean       @default(false)
  abilityOptions    String[]      @default([]) // abilities the player may raise by abilityIncrease
  abilityIncrease   Int           @default(0) // usually 1 for half-feats
  improvements      Json          @default("[]") // FeatImprovement[]: { target, amount, perLevel? }
  // NULL = valid in both editions; a diverging feat (e.g. Alert) forks into one row per edition sharing this name. NULLS NOT DISTINCT on the migration's unique index — see resolveEditionRow.
  edition           RulesEdition?
  // [] = any class with the feature may take this feat. Non-empty restricts it to those classes, matched case-insensitively — PHB'14's per-class Fighting Style subset. Read through fightingStyleFeatOfferedForClasses (lib/srd/feats.ts), the one edition-parameterized rule function — never a second column and never `=== "EDITION_…"`.
  classes           String[]      @default([])

  originForBackgrounds Background[]

  @@unique([name, edition])
}

// One row per piece of catalog content regardless of `kind`, carrying WHO owns it and WHO may see it — the concern every per-kind table used to duplicate for itself (#1796). Deliberately carries no back-relation to any per-kind table: a generic supertype that named its own subtypes would defeat the point of being generic. The per-kind table points up at its CatalogEntry via a bare scalar instead (see Spell.catalogEntryId's own comment).
enum CatalogKind {
  SPELL
}

// GLOBAL = seeded system content, visible to everyone. USER = a player's homebrew, visible only to them until granted into a campaign. CAMPAIGN = a DM's homebrew, scoped to their campaign.
enum CatalogScope {
  GLOBAL
  USER
  CAMPAIGN
}

model CatalogEntry {
  id    String       @id @default(uuid())
  kind  CatalogKind
  scope CatalogScope

  // Exactly one of ownerUserId/ownerCampaignId is set, matching `scope` (GLOBAL: neither) — a CHECK constraint enforces this; Prisma's DSL can't express a cross-column conditional, so it's hand-written into the migration.
  ownerUserId String?
  ownerUser   User?   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  ownerCampaignId String?
  ownerCampaign   Campaign? @relation(fields: [ownerCampaignId], references: [id], onDelete: Cascade)

  name    String
  edition RulesEdition

  // Fork provenance. SetNull, not Cascade: the origin being deleted must not take every fork of it down too — a fork stands on its own copy of the content the moment it exists.
  forkedFromId String?
  forkedFrom   CatalogEntry?  @relation("Fork", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        CatalogEntry[] @relation("Fork")

  grants CatalogGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NULLS NOT DISTINCT so two GLOBAL (both owner arms null) rows can't share a (kind, name, edition). Hand-written into the migration — Prisma 7.8 rejects the `nullsNotDistinct` attribute.
  @@unique([kind, scope, ownerUserId, ownerCampaignId, name, edition])
  @@index([kind, scope])
  @@index([ownerUserId])
  @@index([ownerCampaignId])
  @@index([forkedFromId])
}

// One entry may be granted into many campaigns; one campaign may hold many grants — hence the plain join table rather than a column on CatalogEntry.
model CatalogGrant {
  id String @id @default(uuid())

  catalogEntryId String
  catalogEntry   CatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([catalogEntryId, campaignId])
  @@index([campaignId])
}

// Never referenced by a direct FK on Character; provenance lives in the per-character spellcasting JSON blob's SpellEntry.spellId field, nullable so homebrew spells have no catalog row. All per-spell mechanical data lives here rather than on a *Detail table — spells are flat, not category-polymorphic like items.
model Spell {
  id            String      @id @default(uuid())
  name          String
  level         Int // 0 = cantrip
  school        SpellSchool
  castingTime   String
  range         String
  duration      String
  description   String
  concentration Boolean     @default(false)
  ritual        Boolean     @default(false)

  // { verbal: bool, somatic: bool, material: bool, materialDescription?: string }
  components Json?

  // RollSpec-shaped, mirrors ItemWeaponDetail / ItemConsumableDetail. null = utility spell.
  effectKind         String? // "damage" | "heal" | "buff" — null means utility (no roll)
  effectDiceCount    Int?
  effectDiceFaces    Int?
  effectModifier     Int? // flat bonus added after dice (e.g. +3 in "3d4+3")
  damageType         String? // "fire" / "radiant" / etc. — for damage spells
  attackType         String? // "attack" | "save" | null
  saveAbility        String? // ability the target saves with, e.g. "dexterity"
  // `buffModifier` is the ABSOLUTE value the AC target reads, never a delta over the base: "ac" is a flat +N add, "acUnarmoredBase" is the full unarmored base, "acFloor" is the floor. Duration derives from `concentration`. null = not a buff.
  buffTarget         String?
  buffModifier       Int?
  // "half" = half damage on a successful save, "none" = no damage on save. null for attack spells / utility.
  saveEffect         String?
  // null = spell has no upcast scaling.
  upcastDicePerLevel Int?
  // Cantrip damage scales with character level (5/11/17 thresholds) per 5e rules.
  cantripScaling     Boolean @default(false)

  grantedBy        SubclassGrantedSpell[]
  speciesGrantedBy SpeciesGrantedSpell[]
  // A picker-only widening, never a free grant (see grantedBy above).
  listExpandedBy   SubclassSpellListExpansion[]
  // Replaces the old `classes String[]` column. No `edition` filter needed on this side: a 2014-fork Spell row and its 2024 sibling are separate Spell rows, each owning disjoint SpellClass rows already.
  classMemberships SpellClass[]

  // NULL = valid in both editions; a diverging spell forks into one row per edition sharing this name. NULLS NOT DISTINCT on the migration's unique index — see resolveEditionRow. The existing ~109 seeded rows are SRD 5.2 text and are tagged EDITION_2024, not NULL — they're edition-specific content, not rules that happen to agree.
  edition RulesEdition?

  // Every Spell row — seeded or homebrew — is 1:1 with exactly one CatalogEntry, which carries ownership/scope. A bare scalar, deliberately with no Prisma relation field: CatalogEntry carries no back-relation to Spell either, which keeps the supertype closed to future kinds instead of hard-coupling it to Spell specifically. The FK constraint (ON DELETE CASCADE) is hand-written into the migration — Prisma only emits one from an actual `@relation`.
  catalogEntryId String @unique
}

// A single array column can't hold two editions' class lists when they diverge, so membership moves to a queryable, homebrew-friendly join.
// No `edition` column: edition rides the parent Spell row, so a 2014-fork spell and its 2024 sibling are two separate Spell rows, each with its own disjoint SpellClass rows. onDelete: Cascade so a content slice's reseed pruning a stale Spell row never leaves an orphaned membership row behind.
model SpellClass {
  id        String @id @default(uuid())
  spellId   String
  spell     Spell  @relation(fields: [spellId], references: [id], onDelete: Cascade)
  className String // lowercase class name, e.g. "wizard"

  @@unique([spellId, className])
  // className isn't the leading column of the unique(spellId, className) index above, so the ?class= route filter (classMemberships.some, spells.ts) can't use it.
  @@index([className])
}

// Never referenced directly by Character — only through InventoryItem.itemId, which is nullable, so editing/removing a catalog row never breaks an existing character's inventory. Mechanical fields specific to one category live on the optional *Detail tables below rather than as nullable columns here.
model Item {
  id           String        @id @default(uuid())
  scope        ItemScope     @default(GLOBAL)
  // Non-null uniqueness discriminator: "global" or "campaign:<campaignId>". The rule is "a name is unique among GLOBAL rows only" — @@unique([campaignId, name]) is SILENTLY wrong because Postgres treats NULLs as distinct, and Prisma 7.8 rejects `nullsNotDistinct`. Redundant with scope/campaignId by construction; item-scope.integration.test.ts asserts the agreement.
  scopeKey     String
  campaignId   String?
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name         String
  category     ItemCategory
  weight       Float?
  cost         Json? // {cp,sp,gp,pp} — sell/buy default, player can override
  description  String?
  // null = bag-only (not wearable). Weapons and body armor derive their slot from detail data, so this is only set for wearable gear.
  slot         EquipSlot?
  // Set only for the small set of Item rows that ARE tools; null for everything else. Lets a StartingEquipmentOpenPick filter "musical instrument" / "artisan tool" as a column read, never a reach into lib/srd/tools.ts from the equipment resolver.
  toolCategory ToolCategory?

  rarity                ItemRarity?
  requiresAttunement    Boolean               @default(false)
  // null kind = attunable by anyone — distinct from requiresAttunement false.
  attunementPrereqKind  AttunementPrereqKind?
  attunementPrereqValue String?
  isUnique              Boolean               @default(false)
  // Never serialized into a player-facing response. Meaningful only on CAMPAIGN rows.
  dmNotes               String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  weaponDetail     ItemWeaponDetail?
  armorDetail      ItemArmorDetail?
  consumableDetail ItemConsumableDetail?
  capabilities     ItemCapability[]

  inventoryItems InventoryItem[]
  packContents   PackContent[]
  // The fronting ITEM CampaignEntity link. Only ever set on a CAMPAIGN-scoped row.
  link           CampaignItemLink?

  @@unique([scopeKey, name])
  @@index([campaignId])
}

model ItemCapability {
  id     String @id @default(uuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  kind        CapabilityKind
  description String?

  // passiveBonus payload
  target    CapabilityTarget?
  op        CapabilityOp?
  value     Int?
  // Specific skill/ability/save key when target is skill|abilityScore|save.
  targetKey String?
  condition String?

  valueDiceCount  Int?
  valueDiceFaces  Int?
  valueDamageType String?

  // castSpell payload: the item grants a spell cast from the item itself.
  spellId           String? // catalog Spell.id provenance
  spellName         String? // snapshot for display without a catalog join
  spellLevel        Int?
  castLevel         Int? // slot level the item casts the spell at
  castResource      CapabilityCastResource?
  castUses          Int? // uses per recharge period (null = 1)
  castConcentration Boolean?
  dcMode            CapabilityCastStatMode?
  dcValue           Int?
  attackMode        CapabilityCastStatMode?
  attackValue       Int?

  // activatedEffect payload. The inline while-active self-buff reuses the target/op/value columns above; these add the activation + recharge model.
  activation        ActivationType?
  activatedDuration ActivatedDuration?
  resourceKind      ItemResourceKind?
  resourcePeriod    ItemResourcePeriod?
  resourceCharges   Int?
  durationText      String?

  // grant payload: resistance/immunity/conditionImmunity/advantage/proficiency.
  grantType       String?
  grantOn         String?
  grantValueKind  String?
  grantValue      String?
  cantBeSurprised Boolean @default(false)

  // charges payload: the item's shared charge pool — at most ONE charges row per item (authoring-enforced). All-null recharge dice = full refill on the trigger.
  maxCharges        Int?
  rechargeDiceCount Int?
  rechargeDiceFaces Int?
  rechargeBonus     Int?
  rechargeTrigger   ItemResourcePeriod?
  // Cost paid by a castSpell/activatedEffect capability whose resource is `charges` (null = 1). Lives on the SPENDING capability's row.
  chargeCost        Int?

  @@index([itemId])
}

// The FK lives here (joins up to Item) rather than Item holding a column that points at this table — keeps Item itself free of per-category columns no matter how many detail tables exist. Dice fields are decomposed to match frontend/src/lib/dice.ts's RollSpec shape rather than a "1d6" string.
model ItemWeaponDetail {
  id     String @id @default(uuid())
  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  damageDiceCount Int
  damageDiceFaces Int
  damageModifier  Int    @default(0)
  damageType      String // e.g. "bludgeoning"

  // Versatile weapons' two-handed grip rolls a different die; null on both means not versatile. Which grip is "currently" in use is deliberately not persisted anywhere.
  versatileDiceCount Int?
  versatileDiceFaces Int?

  finesse     Boolean @default(false)
  light       Boolean @default(false)
  heavy       Boolean @default(false)
  twoHanded   Boolean @default(false)
  reach       Boolean @default(false)
  thrown      Boolean @default(false)
  ammunition  Boolean @default(false)
  rangeNormal Int?
  rangeLong   Int?

  // Used by the starting-equipment resolver to filter open picks. Nullable so existing homebrew weapons require no backfill.
  weaponClass WeaponClass?
  weaponRange WeaponRange?
}

// Shields included — a shield's baseArmorClass is its flat AC bonus rather than a base, same overload the 5e SRD itself uses.
model ItemArmorDetail {
  id     String @id @default(uuid())
  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  armorCategory       ArmorCategory
  baseArmorClass      Int
  dexModifierApplies  Boolean       @default(false)
  dexModifierMax      Int? // null = uncapped (light armor)
  stealthDisadvantage Boolean       @default(false)
  strengthRequirement Int?
}

// Present only when the consumable actually has a roll (e.g. a potion's healing) — a torch wouldn't have one.
model ItemConsumableDetail {
  id     String @id @default(uuid())
  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  effectDiceCount   Int?
  effectDiceFaces   Int?
  effectModifier    Int?
  effectDescription String? // e.g. "Restores hit points"

  // null = stackable; non-null = charged.
  maxUses       Int?
  usesRemaining Int?
}

// The pack itself also exists as a regular catalog Item (category = gear) so it surfaces correctly in StartingEquipmentEditor; this table adds the expansion data.
model Pack {
  id          String        @id @default(uuid())
  name        String        @unique // matches the bundle catalogName, e.g. "Scholar's Pack"
  description String?
  contents    PackContent[]
}

model PackContent {
  id       String @id @default(uuid())
  packId   String
  pack     Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Int    @default(1)

  @@unique([packId, itemId])
}

// itemId is nullable: null means homebrew (no catalog row at all), set means "started from this catalog item," and either way `snapshot` is this row's own copy, free to diverge — e.g. a "Club +1" bumping just its own snapshot.weapon.damageModifier independent of the catalog Club.
model InventoryItem {
  id                    String                @id @default(uuid())
  characterId           String
  character             Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // SetNull so deleting the source Item leaves the awarded snapshot intact.
  itemId                String?
  item                  Item?                 @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name                  String
  category              ItemCategory
  weight                Float?
  cost                  Json?
  description           String?
  quantity              Int                   @default(1)
  // The single source of truth for "is this equipped": the wire `equipped` field is derived as (equippedSlot != null) — there is no persisted `equipped` boolean.
  equippedSlot          EquipSlot?
  slot                  EquipSlot?
  // Display-only, no derivation reads it.
  rarity                ItemRarity?
  // Persisted boolean; the 3-item cap is derived (counted), never stored. attune/unattune go through …/inventory/transactions.
  attuned               Boolean               @default(false)
  // Captured at award time because the frozen copy outlives the mutable/deletable source. prereqKind null = attunable by anyone (distinct from requiresAttunement false = not attunable).
  requiresAttunement    Boolean               @default(false)
  attunementPrereqKind  AttunementPrereqKind?
  attunementPrereqValue String?
  // Eldritch Knight Weapon Bond (2014, PHB'14 p.75): mirrors `attuned` — the WEAPON_BOND_LIMIT-item cap is derived (counted), never stored. A character no longer eligible is handled by reconcileWeaponBond (level-reconciliation.ts).
  weaponBonded          Boolean               @default(false)
  notes                 String?
  position              Int                   @default(0)
  // Reset by the matching rest; the seeded self-buff tracks the "active" state.
  activatedUsesSpent    Int                   @default(0)
  // The frozen half of this row as one document, validated by inventorySnapshotSchema. NOT NULL: every creation path writes one.
  snapshot              Json
  // NON-NULL IFF the snapshot's `consumable.maxUses` is non-null. The rest sweep selects charged rows by `usesRemaining: { not: null }` and refills each to its snapshot maxUses, so a row that breaks this equivalence has its usesRemaining silently reset to null on the next long rest. Write the two together or not at all.
  usesRemaining         Int?

  capabilityUses InventoryCapabilityUse[]
}

// Keyed by the capability's `key` in the snapshot — an opaque string, not tied to any live row's id.
model InventoryCapabilityUse {
  id              String        @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  capabilityKey   String
  used            Int           @default(0)

  @@unique([inventoryItemId, capabilityKey])
  @@index([inventoryItemId])
}

// All meaningful state changes are written here, in the same DB transaction as the state change itself. This is an append-only audit log, NOT event sourcing — the Character row stays the source of truth; these events sit beside it.
//
// Three patterns at work:
//  1. Single-Table Inheritance (category + type discriminators) — one table, one ORDER BY createdAt query. Adding a new domain = adding enum values, not new tables.
//  2. Polymorphic soft-reference (entityType + entityId, no FK) — points at whatever row the event concerns without a hard FK that breaks on deletion.
//  3. before/after JSON snapshots for field-level audit, and the data needed for undo without replaying anything. CharacterEventField rows are derived from the diff at write time.
enum CharacterEventCategory {
  inventory
  hitPoints
  experience
  currency
  spellcasting
  class // subclass selection and future multiclass ops
  resources // superiority dice, ki, rage, maneuvers, etc.
  advancement // ability score improvements and feats
  session // session lifecycle: started / ended
  combat // combat lifecycle: started / ended / round advanced
  conditions // status conditions (prone, poisoned, etc.) + exhaustion level
  effects // active cast-granted stat modifiers (buffs)
  roll // dice rolls logged from the session UI (attack/damage/check/save/initiative)
  // future: journal
}

enum CharacterEventType {
  acquired
  consumed
  sold
  bought
  removed
  // DM campaign-item award/revoke.
  awarded
  revoked
  damage
  heal
  setTemp
  shortRest
  longRest
  levelUp
  levelDown
  deathSave
  stabilize
  xpAward
  xpSet
  currencyAdjust
  castSpell
  castAbilitySlot // row-driven {kind:"slot"} ability spend (#1687)
  expendSlot
  restoreSlot
  learnSpell
  forgetSpell
  prepareSpell
  unprepareSpell
  concentrationDropped
  convertSorceryPoints
  classAdded
  subclassChosen
  subclassRemoved
  fightingStyleChosen
  fightingStyleRemoved
  classLevelsReconciled
  spendResource
  restoreResource
  initiativeRegen
  learnManeuver
  forgetManeuver
  maneuversReconciled
  castManeuver
  castShadowArt
  castChannelDivinity
  castStunningStrike
  imposeOpenHandRider
  setQuiveringPalm
  triggerQuiveringPalm
  dealHandOfHarm
  useHandOfUltimateMercy
  toggleElementalAttunement
  castElementalBurst
  elementalStrike
  learnToolProficiency
  forgetToolProficiency
  toolProficienciesReconciled
  // Choose/undo a skill's double proficiency bonus.
  learnExpertise
  forgetExpertise
  expertiseReconciled
  learnSubclassChoice
  forgetSubclassChoice
  subclassChoicesReconciled
  castDiscipline
  abilityScoreImprovement
  featTaken
  advancementRemoved
  advancementsReconciled
  // equip/unequip are logged so they appear on the timeline.
  equipped
  unequipped
  attuned
  unattuned
  // Eldritch Knight Weapon Bond (2014, PHB'14 p.75).
  weaponBonded
  weaponUnbonded
  activated
  deactivated
  activatedRecharged
  sessionStarted
  sessionEnded
  combatStarted
  combatEnded
  combatRoundAdvanced
  // One undoable event per resolved weapon swing/spell cast, carrying its rolls in `data` — replaces the separate attackRoll/damageRoll/castSpell rows a resolution used to write.
  resolveAction
  conditionApplied
  conditionRemoved
  exhaustionSet
  buffApplied
  buffCleared
  // Non-undoable.
  attackRoll
  damageRoll
  checkRoll
  saveRoll
  initiativeRoll
  revert
}

model CharacterEvent {
  id          String                 @id @default(uuid())
  characterId String
  character   Character              @relation(fields: [characterId], references: [id], onDelete: Cascade)
  category    CharacterEventCategory
  type        CharacterEventType
  // Stored so the timeline renders correctly even if op semantics change in a future version.
  summary     String
  // Polymorphic soft-reference — no FK, so the event survives deletion of the referenced row. entityType = "InventoryItem", entityId = the row's id.
  entityType  String?
  entityId    String?
  // Null for historical rows backfilled from InventoryTransaction (no data). For undo: restoring `before` reverses any event that carries it.
  before      Json?
  after       Json?
  // Op-specific inputs that aren't derivable from before/after alone. Also carries undo-reconstruction data the revert handler reads but that must NOT be diffed: inventory delete ops stash a self-contained `data.deletedItem` snapshot here so the deleted row can be rebuilt.
  data        Json?
  // Future-proofs multi-user "who performed this action" — single-player today, so always "player".
  actor       String                 @default("player")
  // Set true when compensated via an appended revert meta-event; the reverted row is never deleted — history is append-only.
  reverted    Boolean                @default(false)
  batchId     String?
  // Null for events that happen outside a session.
  sessionId   String?
  session     Session?               @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())

  fields CharacterEventField[]

  @@index([characterId, createdAt])
  @@index([entityType, entityId])
  @@index([sessionId, createdAt])
}

// At most one `active` session per campaign is DB-enforced by the hand-written partial unique index
// Session_campaignId_active_key — Prisma's DSL cannot express a partial (WHERE-clause) index, so it has
// no field here to attach to. At most one `active` solo session per character (campaignId null) is
// enforced in lib only: a solo session's character lives on SessionParticipant, a separate table, and a
// partial unique index can only constrain columns of the table it's defined on, so this half of the
// invariant has no DB-level equivalent yet.
model Session {
  id           String        @id @default(uuid())
  // Null for a character-scoped solo session.
  campaignId   String?
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status       SessionStatus @default(active)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  title        String?
  // SetNull so deleting an arc leaves the session intact and merely un-arced.
  arcId        String?
  arc          CampaignArc?  @relation(fields: [arcId], references: [id], onDelete: SetNull)
  // Null while active.
  summary      Json?
  // A deliberate DERIVE-DON'T-PERSIST EXCEPTION: the round is shared mutable state every participant's client must observe identically, which is impossible to derive per-client. This is the authoritative read model; combatStarted/combatEnded/combatRoundAdvanced CharacterEvent rows remain the audit trail, not the source of truth.
  combatActive Boolean       @default(false)
  round        Int           @default(0)
  updatedAt    DateTime      @updatedAt

  events         CharacterEvent[]
  journalEntries JournalEntry[]
  participants   SessionParticipant[]

  @@index([campaignId, status])
  @@index([arcId])
}

model SessionParticipant {
  id                String         @id @default(uuid())
  sessionId         String
  session           Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  characterId       String
  character         Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  joinedAt          DateTime       @default(now())
  leftAt            DateTime?
  summary           Json?
  // A second DERIVE-DON'T-PERSIST EXCEPTION alongside Session.combatActive/round. The 5e bonus-action spellcasting interlock is a function of the TURN, not the character, so it cannot be derived from any character column — it is shared state two clients viewing this participant must agree on and that must survive a reload. Per-participant, not on Session: a shared field would let one PC's cast wrongly block another's. Recorded when a spell resolves; reset to null at every turn boundary. Null = nothing of that economy kind cast this turn. The resolved interlock flags are computed from these via the one shared rule fn (spellEconomyRestrictions).
  spellCastAsAction SpellCastKind?
  spellCastAsBonus  SpellCastKind?
  // Bumped on every cast-record/reset above so the combat-state payload's `updatedAt` (max of this and Session.updatedAt) advances on a participant-only change, keeping the client's monotonic sync guard correct for the interlock flags, not just for round.
  updatedAt         DateTime       @default(now()) @updatedAt

  @@unique([sessionId, characterId])
  @@index([sessionId])
}

// Mirrors the client's SpellCastKind union.
enum SpellCastKind {
  cantrip
  leveled
}

// kind distinguishes the two capture surfaces sharing this table: full ENTRY rows (date/body form) vs. fast NOTE rows (one-line in-session capture). EntryVisibility: new entries default CAMPAIGN inside a campaign (author can opt out to PRIVATE); campaign-less writes are PRIVATE.
enum JournalEntryKind {
  NOTE
  ENTRY
}

enum EntryVisibility {
  PRIVATE
  CAMPAIGN
}

// Purely user-authored notes with no mechanical effect, so (unlike inventory/HP/XP/spellcasting) NOT routed through the audit log / transaction pattern: plain REST CRUD writes directly here.
model JournalEntry {
  id           String           @id @default(uuid())
  characterId  String
  character    Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      Session?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  kind         JournalEntryKind @default(ENTRY)
  date         DateTime
  loggedAt     DateTime         @default(now())
  body         String
  visibility   EntryVisibility  @default(PRIVATE)
  // Denormalized so visibleEntries and the backlinks visibility filter can gate by author without a join.
  authorUserId String
  createdAt    DateTime         @default(now())

  refs JournalEntryRef[]

  @@index([characterId, createdAt])
}

// The "field-level" layer of the "both layers" granularity choice. Cascades with the parent event.
model CharacterEventField {
  id       String         @id @default(uuid())
  eventId  String
  event    CharacterEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  path     String // e.g. "hitPoints.max", "currency.gp", "quantity"
  oldValue Json?
  newValue Json?
}
