BACKEND_PORT=4000
FRONTEND_PORT=5173
# Keeps the SPA same-origin: it calls /api on its own origin and Vite's dev proxy
# forwards to the backend (target: VITE_PROXY_TARGET, default
# http://localhost:4000). Leave as /api unless you intentionally point the SPA at
# an absolute API origin.
VITE_API_URL=/api

# ── Google OAuth (optional; sign-in is disabled until both are set) ───────────
# 1. Google Cloud Console → Credentials → OAuth client ID (Web application).
# 2. Configure the consent screen (add yourself as a test user while unpublished).
# 3. Authorized redirect URI: http://localhost:5173/api/auth/google/callback
# APP_BASE_URL is the browser-facing app origin (the SPA, which proxies /api).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:5173

# Enables POST /api/auth/dev-login, the passwordless session `npm run seed:verify`
# and the e2e global setup both sign in with. Nothing injects it for you any more
# (#1468) — host dev gets it from here, CI from ci.yml, worktrees from
# worktree.sh write_env. Off, the endpoint 404s and both die at sign-in with an
# error that never names the cause. Safe to ship on because parseDevLogin forces
# it off under NODE_ENV=production; still never set it in a real deploy.
ALLOW_DEV_LOGIN=true

# Without this the limiter is live in dev, and an e2e run's repeated dev-logins
# trip it mid-suite as a 429. Same provisioning story as ALLOW_DEV_LOGIN above.
# Unlike it, this one has NO production hard-off — it is contained only by this
# file being the dev template; the prod one is .env.production.example.
RATE_LIMIT_DISABLED=true

# ── Blob storage (optional in dev; defaults to the fs driver in a tmpdir) ─────
# BLOB_STORE_DRIVER=fs        # s3 | fs; required in production
# BLOB_FS_DIR=                # fs driver directory (default: OS tmpdir path)
# S3_ENDPOINT=                # required by every S3-compatible except AWS itself
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

POSTGRES_USER=character_sheet
POSTGRES_PASSWORD=character_sheet
POSTGRES_DB=character_sheet
POSTGRES_PORT=5432
# The backend runs on the host and dials the published POSTGRES_PORT above; keep
# the two in sync. A worktree slot overrides both with its own port.
DATABASE_URL=postgresql://character_sheet:character_sheet@localhost:5432/character_sheet

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
