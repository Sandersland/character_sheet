# Copy to frontend/.env.production (gitignored):
#   cp frontend/.env.production.example frontend/.env.production
#
# Read by `vite build` / `vite preview` (mode "production") — the build the
# Playwright container exercises via `npm run e2e`. Same relative value and
# same reason as frontend/.env.development.example: keeps the SPA same-origin
# instead of falling back to http.ts's absolute default. Mirrors what
# `.claude/skills/worktree/worktree.sh write_env` generates per worktree slot
# (#1479).
VITE_API_URL=/api
