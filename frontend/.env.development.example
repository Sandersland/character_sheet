# Copy to frontend/.env.development (gitignored):
#   cp frontend/.env.development.example frontend/.env.development
#
# Relative so the SPA rides Vite's dev proxy (server.proxy in vite.config.ts)
# and stays same-origin for the session cookie; the backend sends no CORS
# headers unless CORS_ORIGIN is set. Matches the http.ts default.
# Mirrors what `.claude/skills/worktree/worktree.sh write_env` generates per
# worktree slot (#1479).
VITE_API_URL=/api
