# Combined single-origin image: builds the React SPA and serves it from the API
# server (SERVE_STATIC_DIR=/app/public). One container, one origin, one
# Cloudflare Access policy. This is the image the Railway dev environment uses.
#
# Split mode (SPA and API on separate hosts) had two images here until #1456
# deleted them unbuilt: single-origin is a commitment, not a default. The
# image builds from the REPO ROOT context so the npm-workspaces install can
# link packages/* (shared-types, #820): root
# manifests + packages/ first (cache-friendly — they change rarely), then
# `npm ci --workspace <ws>` against the single root lockfile, then sources.

# Pinned to an exact patch so a rebuild never silently lands on an older
# cached tag; bump together with .nvmrc.
ARG NODE_IMAGE=node:24.22.3-alpine

# 1. Build the SPA with a relative API base so it talks to the same origin.
FROM ${NODE_IMAGE} AS frontend
WORKDIR /app
# Root lockfile was generated by npm 11 — align the CLI like CI does (npm/cli#4828).
RUN npm install -g npm@11
COPY package.json package-lock.json ./
COPY packages/ packages/
COPY frontend/package.json frontend/
RUN npm ci --workspace frontend
COPY frontend/ frontend/
WORKDIR /app/frontend
ENV VITE_API_URL=/api
RUN npm run build

# 2. Build the backend: install deps, generate the Prisma client, compile TS.
FROM ${NODE_IMAGE} AS backend
WORKDIR /app
RUN npm install -g npm@11
COPY package.json package-lock.json ./
COPY packages/ packages/
COPY backend/package.json backend/
RUN npm ci --workspace backend
# packages/contracts compiles to JS because the backend imports its zod schemas
# as VALUES and plain `node` will not load its .ts sources (#1370). .dockerignore drops
# **/dist, so the host's build never leaks in — this line is the only thing that
# puts dist/ in the image, and stage 3's `COPY --from=backend /app /app` carries it.
# The load assertion walks EVERY *Schema export rather than spot-checking one, so
# a barrel that drops a schema fails the image build instead of at first request;
# the count guard keeps an empty barrel from passing vacuously — it must be
# raised to the tree's real export count whenever a family is added, or a barrel
# that loads only the old subset passes for the wrong reason.
RUN npm run build --workspace @character-sheet/contracts \
 && node --input-type=module -e "import('@character-sheet/contracts').then(m => { const s = Object.keys(m).filter(k => k.endsWith('Schema')); if (s.length < 53 || s.some(k => typeof m[k]?.parse !== 'function')) { console.error('contracts barrel failed to load:', s.length, 'schemas'); process.exit(1); } console.log('contracts:', s.length, 'schemas loaded'); })"
COPY backend/ backend/
WORKDIR /app/backend
# prisma.config.ts resolves env("DATABASE_URL") when the CLI loads it, so a
# placeholder is required even though `generate` never connects to a database.
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" npx prisma generate && npm run build

# 3. Production dependencies only. The Prisma CLI and tsx are devDependencies
# but the pre-deploy migrate+seed step needs them at runtime, so they are
# merged in at the versions the lockfile already pins: no manifest or lockfile
# churn, and every other dev dependency stays out of the image.
FROM ${NODE_IMAGE} AS prod-deps
WORKDIR /app
RUN npm install -g npm@11
COPY package.json package-lock.json ./
COPY packages/ packages/
COPY backend/package.json backend/
RUN npm ci --workspace backend --omit=dev
# npm would prune devDependencies again if tsx were installed into the workspace
# tree, so it goes into a scratch dir and is merged without clobbering.
RUN mkdir /tools && cd /tools && npm init -y >/dev/null \
 && npm install --no-package-lock \
    "prisma@$(node -p "require('/app/package-lock.json').packages['node_modules/prisma'].version")" \
    "tsx@$(node -p "require('/app/package-lock.json').packages['node_modules/tsx'].version")" \
 && cd /tools/node_modules \
 && for p in $(ls -d * @*/* 2>/dev/null | grep -v '^@[^/]*$'); do \
      [ -e "/app/node_modules/$p" ] || { mkdir -p "/app/node_modules/$(dirname "$p")" && cp -r "$p" "/app/node_modules/$p"; }; \
    done \
 && for b in .bin/*; do [ -e "/app/node_modules/$b" ] || cp -P "$b" "/app/node_modules/$b"; done \
 && rm -rf /tools

# 4. Runtime: prod node_modules, the compiled backend + the sources migrate/seed
# run from, and the built SPA served as static files. Boots the server only;
# migrate+seed is a separate once-per-deploy step (railway.json
# preDeployCommand, docker-compose.prod.yml `migrate` service) because the seed
# prunes catalog rows, so an older image restarting must never re-run it.
FROM ${NODE_IMAGE}
ENV NODE_ENV=production
WORKDIR /app/backend
COPY --from=prod-deps /app/node_modules /app/node_modules
COPY --from=backend /app/packages /app/packages
COPY --from=backend /app/package.json /app/package-lock.json /app/
COPY --from=backend /app/backend /app/backend
COPY --from=frontend /app/frontend/dist /app/public
ENV SERVE_STATIC_DIR=/app/public
ENV PORT=4000
EXPOSE 4000
USER node
CMD ["node", "dist/index.js"]
